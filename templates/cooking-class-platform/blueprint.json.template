  ],
  "data_models": [
    { "name": "User", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "cookingPreferences", "type": "string[]", "required": false }, { "name": "dietaryRestrictions", "type": "string[]", "required": false }, { "name": "skillLevel", "type": "enum(beginner|intermediate|advanced)", "required": false } ] },
    { "name": "CookingClass", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "cuisine", "type": "string", "required": true }, { "name": "difficulty", "type": "string", "required": true }, { "name": "dietary", "type": "string", "required": true }, { "name": "instructor", "type": "string", "required": true }, { "name": "date", "type": "date", "required": true }, { "name": "time", "type": "string", "required": true }, { "name": "duration", "type": "string", "required": true }, { "name": "seats", "type": "integer", "required": true }, { "name": "booked", "type": "boolean", "required": false, "default": false }, { "name": "price", "type": "decimal", "required": true } ] },
    { "name": "VideoTutorial", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "cuisine", "type": "string", "required": true }, { "name": "difficulty", "type": "string", "required": true }, { "name": "dietary", "type": "string", "required": true }, { "name": "duration", "type": "string", "required": true }, { "name": "views", "type": "integer", "required": false }, { "name": "url", "type": "string", "required": true } ] },
    { "name": "Recipe", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "cuisine", "type": "string", "required": true }, { "name": "difficulty", "type": "string", "required": true }, { "name": "dietary", "type": "string", "required": true }, { "name": "prepTime", "type": "integer", "required": true }, { "name": "cookTime", "type": "integer", "required": true }, { "name": "servings", "type": "integer", "required": true }, { "name": "calories", "type": "integer", "required": false }, { "name": "rating", "type": "decimal", "required": false }, { "name": "ingredientCount", "type": "integer", "required": false } ] },
    { "name": "MealPlan", "fields": [ { "name": "weekLabel", "type": "string", "required": true }, { "name": "days", "type": "object[]", "required": true } ] },
    { "name": "Chef", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "specialty", "type": "string", "required": true }, { "name": "rating", "type": "decimal", "required": true }, { "name": "reviews", "type": "integer", "required": true }, { "name": "sessionPrice", "type": "decimal", "required": true }, { "name": "bio", "type": "string", "required": false } ] },
    { "name": "ForumPost", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "author", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "replies", "type": "integer", "required": false }, { "name": "likes", "type": "integer", "required": false }, { "name": "time", "type": "string", "required": true }, { "name": "excerpt", "type": "string", "required": true } ] }
  ],
  "integrations": [
