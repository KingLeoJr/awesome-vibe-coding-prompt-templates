    { "name": "Badge", "fields": [ { "name": "name", "type": "string", "required": true }, { "name": "description", "type": "string", "required": false }, { "name": "earned", "type": "boolean", "required": true } ] },
    { "name": "QuizQuestion", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "prompt", "type": "string", "required": true }, { "name": "options", "type": "object[]", "required": true } ] },
    { "name": "LocalBusiness", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "distance", "type": "string", "required": false }, { "name": "address", "type": "string", "required": true }, { "name": "tags", "type": "string[]", "required": false }, { "name": "rating", "type": "decimal", "required": false } ] },
    { "name": "ResourceItem", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "type", "type": "enum(article|video|tool)", "required": true }, { "name": "topic", "type": "string", "required": true }, { "name": "duration", "type": "string", "required": false }, { "name": "url", "type": "string", "required": true } ] }
