  "data_models": [
    { "name": "UserProfile", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "ethicalPreferences", "type": "string[]", "required": true }, { "name": "shoppingHabits", "type": "object[]", "required": false }, { "name": "location", "type": "string", "required": false } ] },
