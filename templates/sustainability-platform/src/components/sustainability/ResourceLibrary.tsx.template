"use client";

import { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { Download, FileText, PlayCircle, Search, SlidersHorizontal, X } from "lucide-react";
import type { ResourceFormat, ResourceItem, ResourceType } from "@/lib/types";

interface ResourceLibraryProps {
  resources: ResourceItem[];
}

const TOPICS = ["Climate change", "Renewable energy", "Waste reduction", "Conservation", "Sustainable living"];
const FORMATS: ResourceFormat[] = ["text", "video", "pdf"];
const TYPES: ResourceType[] = ["guide", "toolkit", "checklist", "video"];

const TYPE_LABELS: Record<ResourceType, string> = {
  guide: "Guides",
  toolkit: "Toolkits",
  checklist: "Checklists",
  video: "Videos",
};

export default function ResourceLibrary({ resources }: ResourceLibraryProps) {
  const [query, setQuery] = useState("");
  const [activeTopic, setActiveTopic] = useState<string | null>(null);
  const [activeFormat, setActiveFormat] = useState<ResourceFormat | null>(null);
  const [activeType, setActiveType] = useState<ResourceType | null>(null);

  const results = useMemo(() => {
    const q = query.trim().toLowerCase();
    return resources.filter((resource) => {
      const matchesQuery =
        !q ||
        resource.title.toLowerCase().includes(q) ||
        resource.description.toLowerCase().includes(q) ||
        resource.topic.toLowerCase().includes(q);
      const matchesTopic = !activeTopic || resource.topic === activeTopic;
      const matchesFormat = !activeFormat || resource.format === activeFormat;
      const matchesType = !activeType || resource.type === activeType;
      return matchesQuery && matchesTopic && matchesFormat && matchesType;
    });
  }, [query, activeTopic, activeFormat, activeType, resources]);

  const hasActiveFilters = query !== "" || activeTopic !== null || activeFormat !== null || activeType !== null;

  const clearAll = () => {
    setQuery("");
    setActiveTopic(null);
    setActiveFormat(null);
    setActiveType(null);
  };

  return (
    <section id="resources" className="bg-gray-50 py-20 dark:bg-gray-900/50">
      <div className="mx-auto max-w-7xl px-6">
        <div className="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p className="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)]">
              Resource library
            </p>
            <h2 className="mt-3 text-3xl font-bold text-gray-900 dark:text-white">
              Guides, toolkits and videos to live sustainably
            </h2>
          </div>
          {hasActiveFilters && (
            <button
              onClick={clearAll}
              className="inline-flex items-center gap-1 rounded-full border border-gray-300 px-4 py-1.5 text-sm font-medium text-gray-600 transition hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900"
            >
              <X className="h-4 w-4" aria-hidden="true" />
              Clear filters
            </button>
          )}
        </div>

        <div className="mt-8 rounded-3xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-950">
          <label className="relative block">
            <Search className="absolute top-1/2 left-4 h-4 w-4 -translate-y-1/2 text-gray-400" aria-hidden="true" />
            <input
              value={query}
              onChange={(event) => setQuery(event.target.value)}
              placeholder="Search resources by topic, title, or format..."
              aria-label="Search resources"
              className="w-full rounded-xl border border-gray-300 bg-white py-2.5 pr-4 pl-11 text-sm text-gray-900 outline-none focus:ring-2 focus:ring-[var(--color-primary)] dark:border-gray-700 dark:bg-gray-900 dark:text-white"
            />
          </label>

          <div className="mt-5 flex flex-wrap items-center gap-2">
            <span className="mr-1 inline-flex items-center gap-1 text-sm font-medium text-gray-700 dark:text-gray-200">
              <SlidersHorizontal className="h-4 w-4" aria-hidden="true" />
              Topic:
            </span>
            {TOPICS.map((topic) => {
              const active = activeTopic === topic;
              return (
                <button
                  key={topic}
                  onClick={() => setActiveTopic(active ? null : topic)}
                  aria-pressed={active}
                  className={`rounded-full px-3.5 py-1.5 text-sm font-medium transition ${
                    active
                      ? "bg-[var(--color-primary)] text-white"
                      : "border border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900"
                  }`}
                >
                  {topic}
                </button>
              );
            })}
          </div>

          <div className="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
            <span className="text-sm font-medium text-gray-700 dark:text-gray-200">Format:</span>
            {FORMATS.map((format) => {
              const active = activeFormat === format;
              return (
                <label key={format} className="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-200">
                  <input
                    type="checkbox"
                    checked={active}
                    onChange={() => setActiveFormat(active ? null : format)}
                    className="h-4 w-4 accent-[var(--color-primary)]"
                  />
                  <span className="capitalize">{format}</span>
                </label>
              );
            })}

            <span className="ml-4 text-sm font-medium text-gray-700 dark:text-gray-200">Type:</span>
            {TYPES.map((type) => {
              const active = activeType === type;
              return (
                <label key={type} className="flex items-center gap-1.5 text-sm text-gray-700 dark:text-gray-200">
                  <input
                    type="checkbox"
                    checked={active}
                    onChange={() => setActiveType(active ? null : type)}
                    className="h-4 w-4 accent-[var(--color-primary)]"
                  />
                  {TYPE_LABELS[type]}
                </label>
              );
            })}
          </div>
        </div>

        <p className="mt-6 text-sm text-gray-600 dark:text-gray-300">
          <strong className="text-gray-900 dark:text-white">{results.length}</strong>{" "}
          {results.length === 1 ? "resource" : "resources"} available
        </p>

        <div className="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {results.map((resource, index) => (
            <motion.article
              key={resource.id}
              initial={{ opacity: 0, y: 12 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.35, delay: index * 0.04 }}
              className="flex flex-col gap-3 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950"
            >
              <div className="flex items-start justify-between gap-3">
                <span className="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
                  {resource.format === "video" ? (
                    <PlayCircle className="h-5 w-5" aria-hidden="true" />
                  ) : (
                    <FileText className="h-5 w-5" aria-hidden="true" />
                  )}
                </span>
                <span className="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 dark:bg-gray-800 dark:text-gray-300">
                  {TYPE_LABELS[resource.type]}
                </span>
              </div>
              <div>
                <h3 className="font-semibold text-gray-900 dark:text-white">{resource.title}</h3>
                <p className="mt-1 line-clamp-2 text-sm text-gray-600 dark:text-gray-300">{resource.description}</p>
              </div>
              <div className="mt-auto flex items-center justify-between border-t border-gray-100 pt-3 text-xs text-gray-500 dark:border-gray-800 dark:text-gray-400">
                <span>
                  {resource.topic} &middot; {resource.size}
                </span>
                <span className="inline-flex items-center gap-1">
                  <Download className="h-3.5 w-3.5" aria-hidden="true" />
                  {resource.downloads.toLocaleString()}
                </span>
              </div>
            </motion.article>
          ))}
        </div>
      </div>
    </section>
  );
}