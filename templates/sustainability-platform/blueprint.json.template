    { "token_type": "mode", "token_name": "mode.dark", "token_value": "class" }
  ],

  "deployment": [
    { "platform": "Vercel", "config": { "framework": "nextjs", "buildCommand": "next build", "images": { "remotePatterns": ["images.unsplash.com"] } } }
  ],

