  "data_models": [
    {
      "name": "Event",
      "fields": [
        { "name": "id", "type": "integer", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "description", "type": "text", "required": false },
        { "name": "date", "type": "datetime", "required": true },
        { "name": "category", "type": "string", "required": true },
        { "name": "location", "type": "string", "required": true },
        { "name": "venue", "type": "string", "required": false },
        { "name": "capacity", "type": "integer", "required": true, "default": 0 },
        { "name": "registered", "type": "integer", "required": true, "default": 0 },
        { "name": "price_from", "type": "decimal", "required": true },
        { "name": "status", "type": "enum", "required": true, "default": "draft" },
        { "name": "tags", "type": "string[]", "required": false }
      ]
    },
    {
      "name": "TicketTier",
      "fields": [
        { "name": "tier", "type": "string", "required": true },
        { "name": "price", "type": "decimal", "required": true },
        { "name": "original_price", "type": "decimal", "required": false },
        { "name": "benefits", "type": "string[]", "required": false },
        { "name": "remaining", "type": "integer", "required": true, "default": 0 }
      ]
    },
    {
      "name": "DiscountCode",
      "fields": [
        { "name": "code", "type": "string", "required": true },
        { "name": "percent", "type": "integer", "required": true },
        { "name": "expires_at", "type": "datetime", "required": false }
      ]
    },
    {
      "name": "Sponsor",
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "tier", "type": "string", "required": true },
        { "name": "logo_url", "type": "string", "required": false },
        { "name": "website", "type": "string", "required": false }
      ]
    },
    {
      "name": "Attendee",
      "fields": [
        { "name": "user_id", "type": "integer", "required": true },
        { "name": "event_id", "type": "integer", "required": true },
        { "name": "status", "type": "enum", "required": true, "default": "registered" },
        { "name": "checked_in_at", "type": "datetime", "required": false },
        { "name": "qr_code", "type": "string", "required": true }
      ]
    }
  ],
  "integrations": [
    { "service": "Stripe", "purpose": "Card payments, refunds, and payout reconciliation", "config_params": { "mode": "payment_intents" } },
    { "service": "PayPal", "purpose": "Alternative payment method for tickets", "config_params": {} },
    { "service": "Mailchimp", "purpose": "Email marketing campaigns and audience segments", "config_params": { "audience": "attendees" } },
    { "service": "Twilio", "purpose": "SMS RSVP reminders and mobile alerts", "config_params": {} },
    { "service": "Google Maps", "purpose": "Venue maps and interactive seating", "config_params": { "libraries": ["places"] } },
    { "service": "Zoom", "purpose": "Virtual event hosting and session streaming", "config_params": {} },
    { "service": "Dialogflow", "purpose": "Chatbot for attendee self-service", "config_params": {} },
    { "service": "Google Calendar", "purpose": "One-click event sync to attendee calendars", "config_params": {} },
    { "service": "Outlook", "purpose": "One-click event sync to Microsoft calendars", "config_params": {} },
    { "service": "Google Analytics", "purpose": "Marketing and conversion tracking", "config_params": { "id": "{{deployment.analytics_id}}" } }
  ],
  "nfrs": [
    { "type": "Security", "requirement": "GDPR compliance with cookie consent, data minimization, and export/deletion APIs" },
