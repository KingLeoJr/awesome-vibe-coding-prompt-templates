    { "type": "Accessibility", "requirement": "WCAG 2.1 AA across all public and organizer surfaces" },
    { "type": "Performance", "requirement": "Lighthouse performance and accessibility scores of 90+ on key pages" },
    { "type": "Responsive", "requirement": "Fully responsive from 320px to 4K; tested mobile-first" },
    { "type": "i18n", "requirement": "Multi-language via i18next with at least 5 locales" },
    { "type": "SEO", "requirement": "Per-event SEO metadata, Open Graph, and structured data (Event schema)" },
    { "type": "PWA", "requirement": "Installable web app with push notifications for updates" },
    { "type": "Testing", "requirement": "RSpec + Jest coverage for ticketing, payments, and check-in flows" }
  ],
