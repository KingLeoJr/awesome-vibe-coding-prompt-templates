"use client";

import { BadgePercent, Check, Ticket } from "lucide-react";
import Card from "@/components/shared/Card";
import { cn } from "@/lib/utils";

export interface TicketTier {
  tier: string;
  price: number;
  originalPrice: number;
  benefits: string[];
  remaining: number;
}

export interface DiscountCode {
  code: string;
  percent: number;
}

interface TicketTierCardProps {
  tier: TicketTier;
  discountCode?: DiscountCode;
  currency?: string;
  featured?: boolean;
  delay?: number;
}

export default function TicketTierCard({
  tier,
  discountCode,
  currency = "$",
  featured = false,
  delay = 0,
}: TicketTierCardProps) {
  const discounted = discountCode
    ? Math.round(tier.price * (1 - discountCode.percent / 100))
    : null;
  const displayPrice = discounted ?? tier.price;
  const soldOut = tier.remaining === 0;

  return (
    <Card
      delay={delay}
      className={cn(
        "flex h-full flex-col gap-4 p-6",
        featured && "ring-2 ring-[color:var(--color-primary)]"
      )}
    >
      <div className="flex items-center justify-between gap-2">
        <h3 className="text-base font-bold text-gray-900 dark:text-white">{tier.tier}</h3>
        {featured && (
          <span className="rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-primary)]">
            Most popular
          </span>
        )}
      </div>

      <div className="flex items-baseline gap-2">
        <span className="text-3xl font-extrabold text-gray-900 dark:text-white">
          {currency}
          {displayPrice}
        </span>
        {tier.originalPrice > displayPrice && (
          <span className="text-base text-gray-400 dark:text-gray-500 line-through">
            {currency}
            {tier.originalPrice}
          </span>
        )}
        {discountCode && (
          <span className="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
            <BadgePercent size={13} aria-hidden /> {discountCode.code}
          </span>
        )}
      </div>

      <ul className="space-y-2.5 text-sm text-gray-600 dark:text-gray-300">
        {tier.benefits.map((benefit) => (
          <li key={benefit} className="flex items-start gap-2.5">
            <Check size={16} className="mt-0.5 shrink-0 text-[var(--color-primary)]" aria-hidden />
            {benefit}
          </li>
        ))}
      </ul>

      <div className="mt-auto flex items-center justify-between gap-3 border-t border-gray-100 dark:border-gray-800 pt-4">
        <p className="text-xs text-gray-400 dark:text-gray-500">
          {soldOut ? "No tickets left" : `${tier.remaining} left`}
        </p>
        <a
          href="#"
          aria-disabled={soldOut}
          className={`inline-flex items-center justify-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-40 ${
            soldOut
              ? "pointer-events-none border border-gray-300 text-gray-400 dark:border-gray-700"
              : featured
                ? "bg-[var(--color-primary)] text-white hover:opacity-90"
                : "border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-900"
          }`}
        >
          <Ticket size={15} aria-hidden /> {soldOut ? "Sold out" : "Select"}
        </a>
      </div>
    </Card>
  );
}
