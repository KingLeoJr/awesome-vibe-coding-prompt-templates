"use client";

import { motion } from "framer-motion";
import { AlertTriangle, Pill, RefreshCcw } from "lucide-react";

export interface Medication {
  id: string;
  name: string;
  dosage: string;
  frequency: string;
  schedule: string[];
  interactions: string[];
  refillDueIn: number;
}

interface MedicationManagerProps {
  medications: Medication[];
}

export default function MedicationManager({ medications }: MedicationManagerProps) {
  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="medications-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex items-center gap-3 mb-8">
          <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
            <Pill size={22} aria-hidden="true" />
          </span>
          <div>
            <h2 id="medications-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Medications</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400">Doses, schedules and drug-interaction checks, all in one place.</p>
          </div>
        </div>

        <div className="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
          {medications.map((med, i) => (
            <motion.article
              key={med.id}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: i * 0.08 }}
              className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
            >
              <div className="flex items-start justify-between">
                <div>
                  <h3 className="font-semibold text-gray-900 dark:text-white">{med.name}</h3>
                  <p className="text-sm text-gray-500 dark:text-gray-400">{med.dosage} · {med.frequency}</p>
                </div>
                {med.refillDueIn <= 7 ? (
                  <span className="inline-flex items-center gap-1 rounded-full bg-amber-500/10 px-2.5 py-1 text-[11px] font-medium text-amber-600 dark:text-amber-400">
                    <RefreshCcw size={12} aria-hidden="true" />
                    Refill in {med.refillDueIn}d
                  </span>
                ) : (
                  <span className="rounded-full bg-emerald-500/10 px-2.5 py-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400">
                    On track
                  </span>
                )}
              </div>

              <div className="mt-4 flex flex-wrap gap-2" aria-label="Daily schedule">
                {med.schedule.map((s) => (
                  <span
                    key={s}
                    className="rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1 text-xs font-medium text-gray-700 dark:text-gray-200"
                  >
                    {s}
                  </span>
                ))}
              </div>

              {med.interactions.length > 0 && (
                <div className="mt-4 rounded-xl border border-amber-500/30 bg-amber-500/5 p-3">
                  <p className="flex items-center gap-1.5 text-xs font-semibold text-amber-600 dark:text-amber-400">
                    <AlertTriangle size={13} aria-hidden="true" />
                    Interaction check
                  </p>
                  <ul className="mt-1.5 flex flex-col gap-1 text-xs text-amber-700 dark:text-amber-300">
                    {med.interactions.map((note) => (
                      <li key={note}>· {note}</li>
                    ))}
                  </ul>
                </div>
              )}

              {med.interactions.length === 0 && (
                <p className="mt-4 rounded-xl bg-emerald-500/5 px-3 py-2 text-xs text-emerald-600 dark:text-emerald-400">
                  No known interactions with your current regimen.
                </p>
              )}
            </motion.article>
          ))}
        </div>
      </motion.div>
    </section>
  );
}