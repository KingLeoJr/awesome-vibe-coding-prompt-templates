"use client";

import { motion, AnimatePresence } from "framer-motion";
import { User, MessageCircle, Star } from "lucide-react";
import { cn } from "@/lib-utils";

interface CoachInfo {
  id: string;
  name: string;
  certifications: string[];
  specialty: string;
  sessionPrice: number;
  bio: string;
}

interface CoachProfileProps {
  coach: CoachInfo;
  onBook?: () => void;
}

export default function CoachProfile({ coach, onBook }: CoachProfileProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="space-y-6"
    >
      <div className="p-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
        <div className="flex items-center gap-4">
          <div className="h-16 w-16 rounded-full bg-gradient-to-br from-{{theme.color.primary}} to-{{theme.color.secondary}} flex items-center justify-center font-bold text-xl">
            {coach.name.substring(0, 1)}
          </div>
          <div>
            <h3 className="font-bold text-gray-900 dark:text-white">{coach.name}</h3>
            <p className="text-sm text-gray-500 dark:text-gray-400">{coach.specialty}</p>
          </div>
        </div>

        <div className="grid grid-cols-2 gap-2 mt-4">
          {coach.certifications.map((cert, index) => (
            <motion.span
              key={index}
              className="px-2 py-1 rounded bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-medium"
              animate={{ opacity: [0, 1], transition: { delay: index * 0.1 } }}
            >
              {cert}
            </motion.span>
          ))}
        </div>

        <p className="mt-4 text-sm text-gray-600 dark:text-gray-300">{coach.bio || "No biography available."}</p>

        {onBook && (
          <button
            onClick={onBook}
            className="mt-4 w-full rounded-full bg-[var(--color-primary)] text-white py-2 text-sm font-medium hover:opacity-90 transition"
            aria-label="Book a session with {coach.name}"
          >
            Book a session
          </button>
        )}
      </div>
    </motion.div>
  );
}