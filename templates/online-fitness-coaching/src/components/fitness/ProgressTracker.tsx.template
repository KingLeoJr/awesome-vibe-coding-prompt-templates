"use client";

import { motion } from "framer-motion";
import { TrendingUp, Calendar, Award } from "lucide-react";
import { cn } from "@/lib-utils";

interface ProgressRecord {
  id: string;
  date: string;
  weight: number | null;
  muscleGain: number | null;
  workoutCompleted: boolean;
}

interface ProgressTrackerProps {
  progress: ProgressRecord[];
  goal: string;
}

export default function ProgressTracker({ progress, goal }: ProgressTrackerProps) {
  const completedWorkouts = progress.filter((p) => p.workoutCompleted).length;

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="space-y-6"
    >
      <div className="p-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
        <div className="grid grid-cols-2 gap-4">
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Workouts Completed</p>
            <p className="text-3xl font-bold text-gray-900 dark:text-white">{completedWorkouts}</p>
          </div>
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Goal</p>
            <p className="text-3xl font-bold text-gray-900 dark:text-white">{goal}</p>
          </div>
        </div>

        <div className="mt-6">
          <h4 className="font-medium text-gray-700 dark:text-gray-300 mb-2">Progress Timeline</h4>
          {progress.map((record, index) => (
            <motion.div
              key={record.id}
              className="p-4 rounded bg-gray-50 dark:bg-gray-800 hover:bg-[var(--color-primary)]/10 transition-colors"
              animate={{ opacity: [0.5, 1], transition: { duration: 0.3, delay: index * 0.1 } }}
            >
              <div className="flex items-center gap-3">
                <Calendar className="h-5 w-5 text-[var(--color-primary)]" />
                <span className="text-sm text-gray-600 dark:text-gray-300">{record.date}</span>
              </div>
              <div className="flex-1">
                <p className="font-medium text-gray-900 dark:text-white">{record.weight !== null ? `${record.weight} kg` : "—"}</p>
                <p className="text-xs text-gray-500 dark:text-gray-400">{record.muscleGain !== null ? `+${record.muscleGain} kg muscle` : ""}</p>
              </div>
              <div className="flex-shrink-0">
                <Award className="h-4 w-4 text-yellow-500" />
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </motion.div>
  );
}