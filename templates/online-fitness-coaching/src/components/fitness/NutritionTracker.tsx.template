"use client";

import { motion } from "framer-motion";
import { ForkAndKnife, Water, Sun } from "lucide-react";
import { cn } from "@/lib-utils";

interface MealLog {
  id: string;
  mealName: string;
  calories: number;
  protein: number | null;
  carbs: number | null;
  fat: number | null;
  loggedAt: string;
}

interface NutritionTrackerProps {
  meals: MealLog[];
  dailyCalorieGoal: number;
}

export default function NutritionTracker({ meals, dailyCalorieGoal }: NutritionTrackerProps) {
  const totalCalories = meals.reduce((sum, m) => sum + m.calories, 0);

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="space-y-6"
    >
      <div className="p-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
        <div className="grid grid-cols-2 gap-4">
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Calories Consumed</p>
            <p className="text-3xl font-bold text-gray-900 dark:text-white">
              {totalCalories} kcal / {dailyCalorieGoal} kcal
            </p>
          </div>
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Remaining</p>
            <p className="text-3xl font-bold text-gray-900 dark:text-white">
              {dailyCalorieGoal - totalCalories} kcal
            </p>
          </div>
        </div>

        <div className="mt-6">
          <h4 className="font-medium text-gray-700 dark:text-gray-300 mb-2">Daily Log</h4>
          {meals.map((meal, index) => (
            <motion.div
              key={meal.id}
              className="p-3 rounded bg-gray-50 dark:bg-gray-800 hover:bg-[var(--color-primary)]/10 transition-colors"
              animate={{ opacity: [0.5, 1], transition: { duration: 0.3, delay: index * 0.08 } }}
            >
              <div className="flex items-center gap-3">
                <ForkAndKnife className="h-4 w-4 text-[var(--color-primary)]" />
                <span className="text-sm font-medium text-gray-900 dark:text-white">{meal.mealName}</span>
                <span className="text-sm text-gray-500 dark:text-gray-400 ml-4">
                  {meal.calories} kcal
                </span>
              </div>
              <div className="flex gap-2 mt-1">
                <motion.div
                  className="h-2 w-1/4 rounded bg-[var(--color-primary)]"
                  style={{ width: `${(meal.calories / dailyCalorieGoal) * 100}%` }}
                  animate={{ width: [`${(meal.calories / dailyCalorieGoal) * 100}%`] }}
                />
              </div>
            </motion.div>
          ))}
          {meals.length === 0 && (
            <p className="text-sm text-gray-500 dark:text-gray-400 mt-2">No meals logged yet. Log your first meal above.</p>
          )}
        </div>
      </div>
    </motion.div>
  );
}