"use client";

import { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { BadgeCheck, Send, Star } from "lucide-react";
import type { Review } from "@/lib/types";

interface ReviewSystemProps {
  reviews: Review[];
}

export default function ReviewSystem({ reviews }: ReviewSystemProps) {
  const [hoverRating, setHoverRating] = useState(0);
  const [submittedRating, setSubmittedRating] = useState(0);
  const [author, setAuthor] = useState("");
  const [comment, setComment] = useState("");
  const [posted, setPosted] = useState(false);

  const average = useMemo(() => {
    const total = reviews.reduce((sum, review) => sum + review.rating, 0);
    return reviews.length ? total / reviews.length : 0;
  }, [reviews]);

  const handleSubmit = (event: React.FormEvent) => {
    event.preventDefault();
    if (submittedRating > 0 && comment.trim() && author.trim()) setPosted(true);
  };

  return (
    <section id="reviews" className="mx-auto max-w-7xl px-6 py-20">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)]">
            Community reviews
          </p>
          <h2 className="mt-3 text-3xl font-bold text-gray-900 dark:text-white">
            What customers are saying
          </h2>
        </div>
        <div className="flex items-center gap-2 rounded-2xl border border-gray-200 bg-white px-5 py-3 dark:border-gray-800 dark:bg-gray-950">
          <span className="flex items-center gap-1" aria-label={`Average rating ${average.toFixed(1)} out of 5`}>
            {Array.from({ length: 5 }).map((_, index) => (
              <Star
                key={index}
                className={`h-5 w-5 ${
                  index < Math.round(average)
                    ? "fill-amber-400 text-amber-400"
                    : "text-gray-300 dark:text-gray-700"
                }`}
                aria-hidden="true"
              />
            ))}
          </span>
          <span className="font-semibold text-gray-900 dark:text-white">{average.toFixed(1)}</span>
          <span className="text-sm text-gray-500 dark:text-gray-400">({reviews.length} reviews)</span>
        </div>
      </div>

      <div className="mt-8 grid gap-6 lg:grid-cols-2">
        <div className="space-y-4">
          {reviews.map((review, index) => (
            <motion.article
              key={review.id}
              initial={{ opacity: 0, y: 12 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.35, delay: index * 0.05 }}
              className="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950"
            >
              <div className="flex items-center justify-between gap-3">
                <div className="flex items-center gap-3">
                  <span className="grid h-10 w-10 place-items-center rounded-full bg-[var(--color-primary)]/10 text-sm font-bold text-[var(--color-primary)]">
                    {review.author.charAt(0)}
                  </span>
                  <div>
                    <p className="flex items-center gap-1.5 font-semibold text-gray-900 dark:text-white">
                      {review.author}
                      {review.verifiedUser && (
                        <BadgeCheck className="h-4 w-4 text-[var(--color-secondary)]" aria-label="Verified user" />
                      )}
                    </p>
                    <p className="text-xs text-gray-500 dark:text-gray-400">{review.date}</p>
                  </div>
                </div>
                <span className="flex items-center gap-0.5" aria-label={`${review.rating} out of 5 stars`}>
                  {Array.from({ length: 5 }).map((_, starIndex) => (
                    <Star
                      key={starIndex}
                      className={`h-4 w-4 ${
                        starIndex < review.rating
                          ? "fill-amber-400 text-amber-400"
                          : "text-gray-300 dark:text-gray-700"
                      }`}
                      aria-hidden="true"
                    />
                  ))}
                </span>
              </div>
              <p className="mt-3 text-sm text-gray-600 dark:text-gray-300">{review.comment}</p>
            </motion.article>
          ))}
        </div>

        <motion.form
          initial={{ opacity: 0, y: 12 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          onSubmit={handleSubmit}
          className="h-fit rounded-2xl border border-gray-200 bg-gray-50 p-6 dark:border-gray-800 dark:bg-gray-900/60"
        >
          <h3 className="font-semibold text-gray-900 dark:text-white">Share your experience</h3>
          {posted ? (
            <p
              role="status"
              className="mt-4 rounded-xl bg-emerald-50 p-4 text-sm font-medium text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300"
            >
              Thanks! Your review has been recorded.
            </p>
          ) : (
            <>
              <div className="mt-4">
                <span className="text-sm font-medium text-gray-700 dark:text-gray-200">Your rating</span>
                <div className="mt-1.5 flex items-center gap-1" onMouseLeave={() => setHoverRating(0)}>
                  {Array.from({ length: 5 }).map((_, index) => {
                    const value = index + 1;
                    const active = (hoverRating || submittedRating) >= value;
                    return (
                      <button
                        key={value}
                        type="button"
                        onClick={() => setSubmittedRating(value)}
                        onMouseEnter={() => setHoverRating(value)}
                        aria-label={`Rate ${value} out of 5 stars`}
                        className="p-0.5"
                      >
                        <Star
                          className={`h-6 w-6 transition ${
                            active ? "fill-amber-400 text-amber-400" : "text-gray-300 dark:text-gray-700"
                          }`}
                          aria-hidden="true"
                        />
                      </button>
                    );
                  })}
                </div>
              </div>

              <label className="mt-4 block text-sm">
                <span className="font-medium text-gray-700 dark:text-gray-200">Name</span>
                <input
                  value={author}
                  onChange={(event) => setAuthor(event.target.value)}
                  required
                  className="mt-1.5 w-full rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 outline-none focus:ring-2 focus:ring-[var(--color-primary)] dark:border-gray-700 dark:bg-gray-950 dark:text-white"
                />
              </label>

              <label className="mt-4 block text-sm">
                <span className="font-medium text-gray-700 dark:text-gray-200">Your review</span>
                <textarea
                  value={comment}
                  onChange={(event) => setComment(event.target.value)}
                  required
                  rows={4}
                  className="mt-1.5 w-full resize-none rounded-xl border border-gray-300 bg-white px-4 py-2.5 text-sm text-gray-900 outline-none focus:ring-2 focus:ring-[var(--color-primary)] dark:border-gray-700 dark:bg-gray-950 dark:text-white"
                />
              </label>

              <button
                type="submit"
                className="mt-5 inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--color-primary)] px-6 py-3 text-sm font-semibold text-white transition hover:brightness-110"
              >
                <Send className="h-4 w-4" aria-hidden="true" />
                Submit review
              </button>
            </>
          )}
        </motion.form>
      </div>
    </section>
  );
}