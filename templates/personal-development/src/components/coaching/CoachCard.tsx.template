"use client";

import { motion } from "framer-motion";
import { BadgeCheck, CalendarClock, Languages, Star, Video } from "lucide-react";
import Card from "@/components/shared/Card";
import { cn } from "@/lib/utils";

export interface Coach {
  id: string;
  name: string;
  title: string;
  expertise: string[];
  rating: number;
  sessions: number;
  avatar: string;
  languages: string[];
  hourlyRate: number;
  certified: boolean;
  nextAvailable: string;
