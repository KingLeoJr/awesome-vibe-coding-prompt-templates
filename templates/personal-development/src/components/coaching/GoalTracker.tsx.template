"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { CheckCircle2, Circle, Flag, Plus, Target } from "lucide-react";
import Card from "@/components/shared/Card";
import { cn } from "@/lib/utils";

export interface Milestone {
  name: string;
  done: boolean;
}

export interface GrowthGoal {
  id: string;
  name: string;
  category: string;
  targetDate: string;
  progress: number;
  milestones: Milestone[];
  habit?: string;
}

interface GoalTrackerProps {
  goals: GrowthGoal[];
}

export default function GoalTracker({ goals }: GoalTrackerProps) {
  const [items, setItems] = useState<GrowthGoal[]>(goals);
  const [draft, setDraft] = useState("");

  const toggleMilestone = (goalId: string, milestoneName: string) => {
    setItems((prev) =>
      prev.map((goal) => {
        if (goal.id !== goalId) return goal;
        const milestones = goal.milestones.map((m) =>
          m.name === milestoneName ? { ...m, done: !m.done } : m
        );
        const done = milestones.filter((m) => m.done).length;
        const progress = milestones.length > 0 ? Math.round((done / milestones.length) * 100) : goal.progress;
        return { ...goal, milestones, progress };
      })
    );
  };

  const addGoal = (e: React.FormEvent) => {
    e.preventDefault();
    if (!draft.trim()) return;
    setItems((prev) => [
      {
        id: `goal-${Date.now()}`,
        name: draft.trim(),
        category: "Personal",
        targetDate: new Date(Date.now() + 90 * 86400000).toISOString().slice(0, 10),
        progress: 0,
        milestones: [],
        habit: "",
      },
      ...prev,
    ]);
    setDraft("");
  };

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="goals-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div className="flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
              <Target size={22} aria-hidden="true" />
            </span>
            <div>
              <h2 id="goals-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Goal tracker</h2>
              <p className="text-sm text-gray-500 dark:text-gray-400">
                Define the objective, check off milestones, and watch progress grow.
              </p>
            </div>
          </div>
        </div>

        <form onSubmit={addGoal} className="mb-8 flex max-w-lg gap-2" aria-label="Add a new goal">
          <input
            type="text"
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            placeholder="New goal — e.g. run a 5K by spring"
            className="flex-1 rounded-full border border-gray-300 dark:border-gray-700 bg-transparent px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
            aria-label="New goal name"
          />
          <button
            type="submit"
            className="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-secondary)] px-5 py-2.5 text-sm font-semibold text-white hover:opacity-90 transition"
          >
            <Plus size={16} aria-hidden="true" />
            Add goal
          </button>
        </form>

        <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {items.map((goal, index) => (
            <motion.div
              key={goal.id}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: index * 0.06 }}
            >
              <Card className="h-full p-6">
                <div className="flex items-start justify-between gap-3">
                  <div>
                    <h3 className="font-semibold text-gray-900 dark:text-white">{goal.name}</h3>
                    <p className="mt-0.5 flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
                      <Flag size={12} aria-hidden="true" />
                      {goal.category} · by {goal.targetDate}
                    </p>
                  </div>
                  <span className="rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-primary)] tabular-nums">
                    {goal.progress}%
                  </span>
                </div>

                <div className="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800" role="progressbar" aria-valuenow={goal.progress} aria-valuemin={0} aria-valuemax={100} aria-label={`${goal.name} progress`}>
                  <motion.div
                    initial={{ width: 0 }}
                    whileInView={{ width: `${goal.progress}%` }}
                    viewport={{ once: true }}
                    transition={{ duration: 0.6, ease: "easeOut" }}
                    className="h-full rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)]"
                  />
                </div>

                {goal.milestones.length > 0 && (
                  <ul className="mt-4 flex flex-col gap-2" aria-label={`Milestones for ${goal.name}`}>
                    {goal.milestones.map((milestone) => (
                      <li key={milestone.name}>
                        <button
                          onClick={() => toggleMilestone(goal.id, milestone.name)}
                          aria-pressed={milestone.done}
                          className={cn(
                            "flex w-full items-center gap-2 rounded-lg px-2 py-1.5 text-left text-sm transition",
                            milestone.done
                              ? "text-gray-400 line-through"
                              : "text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-900"
                          )}
                        >
                          {milestone.done ? (
                            <CheckCircle2 size={16} className="text-[var(--color-primary)]" aria-hidden="true" />
                          ) : (
                            <Circle size={16} className="text-gray-300 dark:text-gray-700" aria-hidden="true" />
                          )}
                          {milestone.name}
                        </button>
                      </li>
                    ))}
                  </ul>
                )}

                {goal.habit && (
                  <p className="mt-4 rounded-xl bg-gray-50 px-3 py-2 text-xs text-gray-500 dark:bg-gray-900 dark:text-gray-400">
                    Daily habit: {goal.habit}
                  </p>
                )}
              </Card>
            </motion.div>
          ))}
        </div>
      </motion.div>
    </section>
  );
}