        <section id="reports" className="scroll-mt-24 bg-gray-50 dark:bg-gray-950/40">
          <ReportExporter format={seo.format as any} onExport={seo.onExport as any} />
        </section>

        <section id="backlinks" className="scroll-mt-24">
          <BacklinkChecker domain={seo.domain as string} onCheck={seo.onCheck as any} />
        </section>
