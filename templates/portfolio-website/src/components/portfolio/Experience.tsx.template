"use client";

import { motion } from "framer-motion";
import { Calendar, Shield, Users, Clock } from "lucide-react";

interface ExperienceProps {
  experiences: { id: string; title: string; company: string; duration: string; description: string }[];
}

export default function Experience({ experiences }: ExperienceProps) {
  const animateVariants = {
    initial: { opacity: 0, y: 20 },
    whileInView: { opacity: 1, y: 0 },
    viewport: { once: true },
    transition: { duration: 0.5 }
  };

  return (
    <section
      className="py-16 bg-white dark:bg-gray-900"
      id="experience"
    >
      <motion.div
        initial={animateVariants.initial}
        whileInView={animateVariants.whileInView}
        viewport={animateVariants.viewport}
        transition={animateVariants.transition}
        className="container mx-auto px-6"
      >
        <h2 className="text-3xl font-bold text-[var(--color-primary)] dark:text-white mb-8">
          Experience
        </h2>

        <div className="space-y-6">
          {experiences.map((exp) => (
            <motion.div
              key={exp.id}
              initial={animateVariants.initial}
              whileInView={animateVariants.whileInView}
              viewport={animateVariants.viewport}
              transition={{
                ...animateVariants.transition,
                delay: experiences.indexOf(exp) * 0.08
              }}
              className="p-6 border rounded-lg bg-gray-50 dark:bg-gray-900"
            >
              <div className="flex items-start gap-4">
                <div className="flex-shrink-0">
                  <Clock className="h-6 w-6 text-[var(--color-primary)]" />
                </div>
                <div>
                  <h3 className="text-lg font-medium text-[var(--color-primary)] dark:text-white">{exp.title}</h3>
                  <p className="text-sm text-gray-500 dark:text-gray-400">{exp.company}</p>
                  <p className="text-sm font-medium mt-1">{exp.duration}</p>
                  <p className="text-gray-600 dark:text-gray-400 mt-2 line-clamp-3">{exp.description}</p>
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </motion.div>
    </section>
  );
}