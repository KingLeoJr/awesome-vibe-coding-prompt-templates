"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { BellRing, CalendarClock, CheckCircle2, Droplets, Scissors, Sprout } from "lucide-react";
import { cn } from "@/lib/utils";

export interface CareTask {
  id: string;
  plant: string;
  task: string;
  frequency: string;
  nextDue: string;
  status: "pending" | "done";
}

interface CareRemindersProps {
  tasks: CareTask[];
}

const TASK_ICONS = {
  water: Droplets,
  feed: Sprout,
  prune: Scissors,
  check: BellRing,
} as const;

export default function CareReminders({ tasks }: CareRemindersProps) {
  const [statuses, setStatuses] = useState<Record<string, CareTask["status"]>>(() =>
    Object.fromEntries(tasks.map((t) => [t.id, t.status]))
  );

  const toggle = (id: string) => {
    setStatuses((prev) => ({ ...prev, [id]: prev[id] === "done" ? "pending" : "done" }));
  };

  const remaining = tasks.filter((t) => (statuses[t.id] ?? t.status) !== "done").length;

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="care-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div className="flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
              <BellRing size={22} aria-hidden="true" />
            </span>
            <div>
              <h2 id="care-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Care reminders</h2>
              <p className="text-sm text-gray-500 dark:text-gray-400">Automated schedules tailored to your plants — never miss a watering.</p>
            </div>
          </div>
          <span className="rounded-full bg-[var(--color-primary)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-primary)]">
            {remaining} due now
          </span>
        </div>

        <ul className="flex flex-col gap-3" aria-label="Care tasks">
          {tasks.map((task, i) => {
            const status = statuses[task.id] ?? task.status;
            const Icon = TASK_ICONS.water;
            const done = status === "done";
            return (
              <motion.li
                key={task.id}
                initial={{ opacity: 0, x: -8 }}
                whileInView={{ opacity: 1, x: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.3, delay: i * 0.05 }}
                className={cn(
                  "flex items-center justify-between gap-4 rounded-2xl border px-5 py-4",
                  done
                    ? "border-[var(--color-primary)]/30 bg-[var(--color-primary)]/5"
                    : "border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950"
                )}
              >
                <div className="flex items-center gap-3">
                  <span
                    className={cn(
                      "flex h-10 w-10 items-center justify-center rounded-full",
                      done ? "bg-[var(--color-primary)]/10 text-[var(--color-primary)]" : "bg-gray-100 dark:bg-gray-900 text-gray-400"
                    )}
                  >
                    <Icon size={18} aria-hidden="true" />
                  </span>
                  <div>
                    <p className="font-medium text-gray-900 dark:text-white">{task.task}</p>
                    <p className="text-xs text-gray-500 dark:text-gray-400">
                      {task.plant} · every {task.frequency}
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-3">
                  <span className="inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                    <CalendarClock size={14} aria-hidden="true" />
                    {task.nextDue}
                  </span>
                  <button
                    onClick={() => toggle(task.id)}
                    aria-pressed={done}
                    aria-label={`Mark ${task.task} ${done ? "as pending" : "as done"}`}
                    className={cn(
                      "flex h-9 w-9 items-center justify-center rounded-full transition",
                      done ? "bg-[var(--color-primary)] text-white" : "bg-gray-100 dark:bg-gray-900 text-gray-400 hover:text-[var(--color-primary)]"
                    )}
                  >
                    <CheckCircle2 size={18} aria-hidden="true" />
                  </button>
                </div>
              </motion.li>
            );
          })}
        </ul>
      </motion.div>
    </section>
  );
}