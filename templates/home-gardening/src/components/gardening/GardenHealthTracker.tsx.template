"use client";

import { motion } from "framer-motion";
import { Activity, Bug, LineChart, Sprout, Trophy } from "lucide-react";

export interface HealthLog {
  id: string;
  date: string;
  plant: string;
  growthRate: number;
  pestSightings: number;
  notes: string;
}

export interface HealthBadge {
  name: string;
  description: string;
  earned: boolean;
}

export interface GardenHealthData {
  logs: HealthLog[];
  metrics: {
    activePlants: number;
    avgGrowthRate: number;
    pestSightings: number;
    wateringsLogged: number;
    goalGrowth: number;
  };
  badges: HealthBadge[];
}

interface GardenHealthTrackerProps {
  health: GardenHealthData;
}

export default function GardenHealthTracker({ health }: GardenHealthTrackerProps) {
  const { logs, metrics, badges } = health;
  const pct = metrics.goalGrowth > 0 ? Math.min(100, Math.round((metrics.avgGrowthRate / metrics.goalGrowth) * 100)) : 0;

  const stats = [
    { label: "Active plants", value: `${metrics.activePlants}`, icon: Sprout, tone: "text-[var(--color-primary)]" },
    { label: "Avg growth rate", value: `${metrics.avgGrowthRate} cm/mo`, icon: LineChart, tone: "text-[var(--color-secondary)]" },
    { label: "Pest sightings", value: `${metrics.pestSightings}`, icon: Bug, tone: "text-[var(--color-accent)]" },
    { label: "Waterings logged", value: `${metrics.wateringsLogged}`, icon: Activity, tone: "text-emerald-500" },
  ];

  return (
    <section aria-labelledby="health-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex items-center gap-3 mb-8">
          <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
            <Activity size={22} aria-hidden="true" />
          </span>
          <div>
            <h2 id="health-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Garden health tracker</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400">Growth rates, pest sightings, and milestones over time.</p>
          </div>
        </div>

        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          {stats.map((stat, i) => (
            <motion.div
              key={stat.label}
              initial={{ opacity: 0, y: 12 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: i * 0.07 }}
              className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-5"
            >
              <div className="flex items-center justify-between">
                <p className="text-sm text-gray-500 dark:text-gray-400">{stat.label}</p>
                <stat.icon size={18} className={stat.tone} aria-hidden="true" />
              </div>
              <p className="mt-2 text-2xl font-bold text-gray-900 dark:text-white">{stat.value}</p>
            </motion.div>
          ))}
        </div>

        <div className="grid gap-5 lg:grid-cols-2">
          <div className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
            <h3 className="font-semibold text-gray-900 dark:text-white">Season growth vs goal</h3>
            <div className="mt-4 h-2.5 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800" role="progressbar" aria-valuenow={pct} aria-valuemin={0} aria-valuemax={100} aria-label="Growth goal progress">
              <motion.div
                initial={{ width: 0 }}
                whileInView={{ width: `${pct}%` }}
                viewport={{ once: true }}
                transition={{ duration: 0.8, ease: "easeOut" }}
                className="h-full rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)]"
              />
            </div>
            <p className="mt-3 text-sm text-gray-500 dark:text-gray-400">
              {metrics.avgGrowthRate} of {metrics.goalGrowth} cm/month ({pct}%).
            </p>

            <ul className="mt-6 space-y-3" aria-label="Recent health logs">
              {logs.map((log, i) => (
                <motion.li
                  key={log.id}
                  initial={{ opacity: 0, x: -8 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ duration: 0.3, delay: i * 0.05 }}
                  className="flex items-center justify-between gap-3 border-b border-gray-100 pb-3 text-sm dark:border-gray-800 last:border-0 last:pb-0"
                >
                  <div>
                    <p className="font-medium text-gray-900 dark:text-white">{log.plant}</p>
                    <p className="text-xs text-gray-500 dark:text-gray-400">{log.date} · {log.notes}</p>
                  </div>
                  <div className="flex shrink-0 gap-2 text-xs">
                    <span className="rounded-full bg-[var(--color-primary)]/10 px-2 py-1 font-semibold text-[var(--color-primary)]">
                      +{log.growthRate} cm
                    </span>
                    {log.pestSightings > 0 && (
                      <span className="rounded-full bg-[var(--color-accent)]/10 px-2 py-1 font-semibold text-[var(--color-accent)]">
                        {log.pestSightings} pests
                      </span>
                    )}
                  </div>
                </motion.li>
              ))}
            </ul>
          </div>

          <div className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
            <h3 className="font-semibold text-gray-900 dark:text-white">Milestones</h3>
            <div className="mt-4 grid grid-cols-2 gap-4">
              {badges.map((badge, i) => (
                <motion.div
                  key={badge.name}
                  initial={{ opacity: 0, scale: 0.95 }}
                  whileInView={{ opacity: 1, scale: 1 }}
                  viewport={{ once: true }}
                  transition={{ duration: 0.3, delay: i * 0.06 }}
                  className={`rounded-xl p-4 text-center ${badge.earned ? "bg-[var(--color-secondary)]/10" : "bg-gray-100 dark:bg-gray-900 opacity-60"}`}
                >
                  <Trophy size={20} className={`mx-auto ${badge.earned ? "text-[var(--color-secondary)]" : "text-gray-400"}`} aria-hidden="true" />
                  <p className="mt-2 text-sm font-semibold text-gray-900 dark:text-white">{badge.name}</p>
                  <p className="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{badge.description}</p>
                </motion.div>
              ))}
            </div>
          </div>
        </div>
      </motion.div>
    </section>
  );
}