"use client";

import { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { Droplets, Flower2, Search, Sun, ThermometerSun } from "lucide-react";

export interface Plant {
  id: string;
  name: string;
  species: string;
  category: string;
  sunlight: string;
  water: string;
  hardiness: string;
  care: string;
  pest: string;
}

interface PlantDatabaseProps {
  plants: Plant[];
}

export default function PlantDatabase({ plants }: PlantDatabaseProps) {
  const [query, setQuery] = useState("");
  const [category, setCategory] = useState("All");
  const [sunlight, setSunlight] = useState("Any");

  const categories = useMemo(() => ["All", ...Array.from(new Set(plants.map((p) => p.category)))], [plants]);
  const sunlights = useMemo(() => ["Any", ...Array.from(new Set(plants.map((p) => p.sunlight)))], [plants]);

  const filtered = useMemo(
    () =>
      plants.filter((p) => {
        const matchesQuery = p.name.toLowerCase().includes(query.toLowerCase()) || p.species.toLowerCase().includes(query.toLowerCase());
        const matchesCategory = category === "All" || p.category === category;
        const matchesSun = sunlight === "Any" || p.sunlight === sunlight;
        return matchesQuery && matchesCategory && matchesSun;
      }),
    [plants, query, category, sunlight]
  );

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="plants-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex items-center gap-3 mb-8">
          <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
            <Flower2 size={22} aria-hidden="true" />
          </span>
          <div>
            <h2 id="plants-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Plant database</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400">Care requirements, growth conditions, and pest management — searchable.</p>
          </div>
        </div>

        <div className="mb-6 flex flex-wrap items-center gap-3">
          <div className="relative flex-1 min-w-[200px] max-w-xs">
            <Search size={16} className="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true" />
            <input
              type="search"
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="Search plants…"
              className="w-full rounded-full border border-gray-300 dark:border-gray-700 bg-transparent pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
              aria-label="Search plants"
            />
          </div>
          <select
            value={category}
            onChange={(e) => setCategory(e.target.value)}
            className="rounded-full border border-gray-300 dark:border-gray-700 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
            aria-label="Filter by category"
          >
            {categories.map((c) => (
              <option key={c} value={c}>{c}</option>
            ))}
          </select>
          <select
            value={sunlight}
            onChange={(e) => setSunlight(e.target.value)}
            className="rounded-full border border-gray-300 dark:border-gray-700 bg-transparent px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
            aria-label="Filter by sunlight"
          >
            {sunlights.map((s) => (
              <option key={s} value={s}>{s === "Any" ? "Any sunlight" : s}</option>
            ))}
          </select>
        </div>

        <div className="grid md:grid-cols-2 xl:grid-cols-3 gap-5">
          {filtered.map((plant, i) => (
            <motion.article
              key={plant.id}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: i * 0.06 }}
              className="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
            >
              <div className="flex items-start justify-between gap-4">
                <div>
                  <h3 className="font-semibold text-gray-900 dark:text-white">{plant.name}</h3>
                  <p className="text-xs italic text-gray-500 dark:text-gray-400">{plant.species}</p>
                </div>
                <span className="rounded-full bg-[var(--color-secondary)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--color-secondary)]">
                  {plant.category}
                </span>
              </div>

              <div className="mt-4 grid grid-cols-3 gap-2 text-center text-xs">
                <div className="rounded-xl bg-gray-50 dark:bg-gray-900 p-3">
                  <Sun size={14} className="mx-auto text-[var(--color-accent)]" aria-hidden="true" />
                  <p className="mt-1 text-gray-500 dark:text-gray-400">Sun</p>
                  <p className="font-medium text-gray-900 dark:text-white">{plant.sunlight}</p>
                </div>
                <div className="rounded-xl bg-gray-50 dark:bg-gray-900 p-3">
                  <Droplets size={14} className="mx-auto text-[var(--color-primary)]" aria-hidden="true" />
                  <p className="mt-1 text-gray-500 dark:text-gray-400">Water</p>
                  <p className="font-medium text-gray-900 dark:text-white">{plant.water}</p>
                </div>
                <div className="rounded-xl bg-gray-50 dark:bg-gray-900 p-3">
                  <ThermometerSun size={14} className="mx-auto text-[var(--color-secondary)]" aria-hidden="true" />
                  <p className="mt-1 text-gray-500 dark:text-gray-400">Zone</p>
                  <p className="font-medium text-gray-900 dark:text-white">{plant.hardiness}</p>
                </div>
              </div>

              <p className="mt-4 text-sm text-gray-600 dark:text-gray-300">{plant.care}</p>
              <p className="mt-2 flex items-start gap-1.5 text-xs text-gray-500 dark:text-gray-400">
                <span className="font-medium text-[var(--color-accent)]">Pests:</span>
                {plant.pest}
              </p>
            </motion.article>
          ))}
        </div>

        {filtered.length === 0 && (
          <p className="rounded-2xl border border-dashed border-gray-300 dark:border-gray-700 p-8 text-center text-sm text-gray-500 dark:text-gray-400">
            No plants match your filters.
          </p>
        )}
      </motion.div>
    </section>
  );
}