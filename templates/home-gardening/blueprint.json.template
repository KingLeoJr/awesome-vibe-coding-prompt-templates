  "data_models": [
    { "name": "GardenProfile", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "preferences", "type": "string[]", "required": true }, { "name": "gardenSize", "type": "string", "required": true }, { "name": "landscapingStyle", "type": "string", "required": false }, { "name": "hardinessZone", "type": "string", "required": true }, { "name": "concerns", "type": "string[]", "required": false } ] },
    { "name": "Plant", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "species", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "sunlight", "type": "string", "required": true }, { "name": "water", "type": "string", "required": true }, { "name": "hardiness", "type": "string", "required": true }, { "name": "care", "type": "string", "required": false }, { "name": "pest", "type": "string", "required": false } ] },
