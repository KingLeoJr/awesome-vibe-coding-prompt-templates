    { "name": "ServiceProvider", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "location", "type": "string", "required": true }, { "name": "rating", "type": "decimal", "required": true }, { "name": "reviewCount", "type": "integer", "required": true }, { "name": "verified", "type": "boolean", "required": true }, { "name": "services", "type": "string[]", "required": false }, { "name": "reviews", "type": "object[]", "required": false } ] },
    { "name": "CareTask", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "plant", "type": "string", "required": true }, { "name": "task", "type": "string", "required": true }, { "name": "frequency", "type": "string", "required": true }, { "name": "nextDue", "type": "date", "required": true }, { "name": "status", "type": "string", "required": true } ] },
    { "name": "HealthLog", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "date", "type": "date", "required": true }, { "name": "plant", "type": "string", "required": true }, { "name": "growthRate", "type": "decimal", "required": false }, { "name": "pestSightings", "type": "integer", "required": false }, { "name": "notes", "type": "string", "required": false } ] },
    { "name": "SeasonalGuideItem", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "season", "type": "string", "required": true }, { "name": "region", "type": "string", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "actions", "type": "string[]", "required": true }, { "name": "plants", "type": "string[]", "required": false } ] }
  ],
  "integrations": [
