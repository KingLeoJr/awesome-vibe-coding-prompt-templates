"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { Award, BookOpenCheck, Clock, GraduationCap } from "lucide-react";
import { cn } from "@/lib/utils";

export interface TrainingModule {
  id: string;
  title: string;
  topic: string;
  level: string;
  duration: string;
  progress: number;
  completed: boolean;
}

interface TrainingModulesProps {
  modules: TrainingModule[];
}

const levelTone: Record<string, string> = {
  Beginner: "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
  Intermediate: "bg-amber-500/10 text-amber-600 dark:text-amber-400",
  Advanced: "bg-rose-500/10 text-rose-600 dark:text-rose-400",
};

export default function TrainingModules({ modules }: TrainingModulesProps) {
  const [completed, setCompleted] = useState<Set<string>>(
    () => new Set(modules.filter((m) => m.completed).map((m) => m.id))
  );

  const toggleComplete = (id: string) => {
    setCompleted((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  const completedCount = completed.size;

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="training-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div className="flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
              <GraduationCap size={22} aria-hidden="true" />
            </span>
            <div>
              <h2 id="training-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Training modules</h2>
              <p className="text-sm text-gray-500 dark:text-gray-400">Courses on first aid, CPR, and essential emergency response skills.</p>
            </div>
          </div>
          <span className="rounded-full bg-[var(--color-secondary)]/10 px-4 py-1.5 text-sm font-semibold text-[var(--color-secondary)]">
            {completedCount}/{modules.length} complete
          </span>
        </div>

        <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {modules.map((module, i) => {
            const isComplete = completed.has(module.id);
            const pct = isComplete ? 100 : module.progress;
            return (
              <motion.article
                key={module.id}
                initial={{ opacity: 0, y: 16 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.4, delay: i * 0.06 }}
                className="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
              >
                <div className="flex items-start justify-between gap-3">
                  <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
                    <BookOpenCheck size={22} aria-hidden="true" />
                  </span>
                  <span className={cn("rounded-full px-2.5 py-1 text-[11px] font-medium capitalize", levelTone[module.level] ?? "bg-gray-100 text-gray-500 dark:bg-gray-900 dark:text-gray-400")}>
                    {module.level}
                  </span>
                </div>

                <h3 className="mt-4 font-semibold text-gray-900 dark:text-white">{module.title}</h3>
                <p className="mt-1 text-sm text-gray-500 dark:text-gray-400">{module.topic}</p>

                <div className="mt-4">
                  <div className="mb-1.5 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                    <span className="flex items-center gap-1.5">
                      <Clock size={13} aria-hidden="true" />
                      {module.duration}
                    </span>
                    <span>{pct}%</span>
                  </div>
                  <div
                    className="h-2 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800"
                    role="progressbar"
                    aria-label={`${module.title} progress`}
                    aria-valuenow={pct}
                    aria-valuemin={0}
                    aria-valuemax={100}
                  >
                    <motion.div
                      initial={{ width: 0 }}
                      whileInView={{ width: `${pct}%` }}
                      viewport={{ once: true }}
                      transition={{ duration: 0.7, ease: "easeOut" }}
                      className="h-full rounded-full bg-[var(--color-secondary)]"
                    />
                  </div>
                </div>

                <button
                  onClick={() => toggleComplete(module.id)}
                  aria-pressed={isComplete}
                  className={cn(
                    "mt-5 inline-flex items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-medium transition",
                    isComplete
                      ? "bg-[var(--color-secondary)] text-white hover:opacity-90"
                      : "bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800"
                  )}
                >
                  <Award size={16} aria-hidden="true" />
                  {isComplete ? "Completed" : "Mark complete"}
                </button>
              </motion.article>
            );
          })}
        </div>
      </motion.div>
    </section>
  );
}