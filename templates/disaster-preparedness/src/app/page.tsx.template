          <AlertCenter alerts={preparedness.alerts as EmergencyAlert[]} />
        </section>

        <section id="community" className="scroll-mt-24 bg-gray-50 dark:bg-gray-950/40">
          <CommunityForum posts={preparedness.forumPosts as ForumPost[]} />
