  ],
  "data_models": [
    { "name": "UserProfile", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "location", "type": "string", "required": true }, { "name": "householdDetails", "type": "object[]", "required": false }, { "name": "preparednessNeeds", "type": "string[]", "required": false } ] },
    { "name": "EmergencyPlan", "fields": [ { "name": "emergencyContacts", "type": "object[]", "required": true }, { "name": "meetingPoints", "type": "object[]", "required": true }, { "name": "evacuationRoutes", "type": "object[]", "required": true }, { "name": "importantDocuments", "type": "object[]", "required": true }, { "name": "familyMembers", "type": "object[]", "required": true }, { "name": "sharedWithFamily", "type": "boolean", "required": false, "default": false } ] },
    { "name": "PreparednessChecklist", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "hazard", "type": "string", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "items", "type": "object[]", "required": true } ] },
    { "name": "TrainingModule", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "topic", "type": "string", "required": true }, { "name": "level", "type": "enum(beginner|intermediate|advanced)", "required": true }, { "name": "duration", "type": "string", "required": true }, { "name": "progress", "type": "integer", "required": true }, { "name": "completed", "type": "boolean", "required": false, "default": false } ] },
    { "name": "EmergencyResource", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "type", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "address", "type": "string", "required": true }, { "name": "phone", "type": "string", "required": false }, { "name": "distanceMiles", "type": "decimal", "required": false }, { "name": "rating", "type": "decimal", "required": false }, { "name": "hours", "type": "string", "required": false } ] },
    { "name": "EmergencyAlert", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "severity", "type": "enum(high|medium|low)", "required": true }, { "name": "type", "type": "string", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "message", "type": "string", "required": true }, { "name": "location", "type": "string", "required": true }, { "name": "time", "type": "string", "required": true }, { "name": "expires", "type": "string", "required": false } ] },
    { "name": "ForumPost", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "author", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "replies", "type": "integer", "required": false }, { "name": "likes", "type": "integer", "required": false }, { "name": "time", "type": "string", "required": true }, { "name": "excerpt", "type": "string", "required": true } ] }
  ],
  "integrations": [
    { "service": "JWT auth", "purpose": "Secure sign-in and account management", "config_params": { "token_ttl": "24h", "refresh": true } },
    { "service": "NOAA / National Weather Service APIs", "purpose": "Live severe-weather warnings and alerts", "config_params": { "endpoints": ["alerts", "forecast"] } },
