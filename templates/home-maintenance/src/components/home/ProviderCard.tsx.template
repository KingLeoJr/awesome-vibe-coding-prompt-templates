"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { Button } from "@/components/shared/Button";
import { Card } from "@/components/shared/Card";
import { lucideReact } from "lucide-react";
import { User, Phone, MapPin, Star, Clock } from "lucide-react";

interface Provider {
  id: string;
  name: string;
  trade: "plumber" | "electrician" | "hvac" | "carpenter" | "landscaper" | "cleaner";
  rating: number;
  reviewCount: number;
  serviceAreas: string[];
  bio: string;
  availability: string;
}

interface ProviderCardProps {
  provider: Provider;
  onBook: () => void;
  delay?: number;
}

export default function ProviderCard({ provider, onBook, delay = 0 }: ProviderCardProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5, delay }}
      className={cn(
        "rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950",
        "hover:shadow-lg transition-shadow",
        "pb-6"
      )}
    >
      <div className="p-6">
        <div className="flex items-start justify-between">
          <div>
            <h3 className="text-xl font-bold text-gray-900 dark:text-white">{provider.name}</h3>
            <p className="mt-1 text-sm text-gray-500 dark:text-gray-400">{provider.bio || "Vetted service provider"}</p>
          </div>
          <div className="flex items-center gap-2">
            {Array(5).fill(0).map((_, i) => (
              <Star
                key={i}
                size={16}
                className={i < provider.rating ? "text-yellow-500" : "text-gray-300"}
              />
            ))}
            <span className="text-gray-500 dark:text-gray-400 ml-1">{provider.rating} ({provider.reviewCount} reviews)</span>
          </div>
        </div>

        <div className="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800">
          <h4 className="text-sm font-medium text-gray-700 dark:text-gray-300">Specialties</h4>
          <div className="flex flex-wrap gap-2 mt-2">
            {["plumbing", "electrical", "hvac", "carpentry", "landscaping", "cleaning"]
              .filter((t) => t !== "cleaning" || provider.trade !== "cleaner")
              .map((t) => {
                const tradeMap: Record<string, string> = {
                  plumbing: "Plumbing",
                  electrical: "Electrical",
                  hvac: "HVAC",
                  carpentry: "Carpentry",
                  landscaping: "Landscaping",
                  cleaning: "Cleaning",
                };
                return (
                  <span
                    key={t}
                    className="inline-flex items-center rounded-full border border-gray-300 dark:border-gray-700 px-2.5 py-0.5 text-xs font-medium capitalize"
                    style={{ color: typeColor(t) }}
                  >
                    {tradeMap[t]}
                  </span>
                );
              })}
          </div>
        </div>

        <div className="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800">
          <h4 className="text-sm font-medium text-gray-700 dark:text-gray-300">Service Areas</h4>
          <p className="text-sm text-gray-500 dark:text-gray-400">{provider.serviceAreas.join(", ")}</p>
        </div>

        <div className="mt-4">
          <Button onClick={onBook} variant="primary" size="sm">
            <Clock size={16} className="mr-2" />
            Book Appointment
          </Button>
          <Button variant="outline" size="sm" href="#">
            View Profile
          </Button>
        </div>
      </div>
    </motion.div>
  );
}

function typeColor(trade: string) {
  const colors: Record<string, string> = {
    plumbing: "blue-500",
    electrical: "yellow-500",
    hvac: "red-500",
    carpentry: "orange-500",
    landscaping: "green-500",
    cleaning: "green-600",
  };
  return colors[trade] || "gray-500";
}