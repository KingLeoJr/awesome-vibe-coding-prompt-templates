"use client";

import { useState } from "react";
import {
  AirVent,
  Camera,
  DoorClosed,
  Fan,
  Lightbulb,
  Lock,
  LockOpen,
  Power,
  Refrigerator,
  Thermometer,
  Tv,
  type LucideIcon,
} from "lucide-react";
import Card from "@/components/shared/Card";
import { cn } from "@/lib/utils";

export interface HomeDevice {
  id: string;
  name: string;
  type: string;
  status: string;
  value: number;
  reading: string;
  online: boolean;
}

interface DeviceCardProps {
  device: HomeDevice;
  onToggle?: (device: HomeDevice) => void;
  delay?: number;
}

const TYPE_ICONS: Record<string, LucideIcon> = {
  light: Lightbulb,
  thermostat: Thermometer,
  air: AirVent,
  tv: Tv,
  lock: Lock,
  camera: Camera,
  fan: Fan,
  door: DoorClosed,
  appliance: Refrigerator,
};

const TOGGLEABLE = new Set(["light", "tv", "appliance", "fan", "thermostat", "lock", "door"]);

function nextStatus(status: string): string {
  switch (status) {
    case "on":
      return "off";
    case "off":
      return "on";
    case "locked":
      return "unlocked";
    case "unlocked":
      return "locked";
    case "closed":
      return "open";
    case "open":
      return "closed";
    default:
      return "on";
  }
}

export default function DeviceCard({ device, onToggle, delay = 0 }: DeviceCardProps) {
  const Icon = TYPE_ICONS[device.type] ?? Power;
  const [status, setStatus] = useState(device.status);
  const toggleable = TOGGLEABLE.has(device.type) && device.online;
  const isOn = ["on", "locked", "closed", "open", "unlocked"].includes(status);

  const handleToggle = () => {
    const next = onToggle ? status : nextStatus(status);
    if (!onToggle) setStatus(next);
    else onToggle({ ...device, status: next });
  };

  return (
    <Card delay={delay} className="flex flex-col gap-3 p-5">
      <div className="flex items-start justify-between gap-3">
        <span
          className={cn(
            "flex h-10 w-10 items-center justify-center rounded-xl",
            isOn
              ? "bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
              : "bg-gray-100 dark:bg-gray-900 text-gray-400"
          )}
        >
          <Icon size={20} aria-hidden />
        </span>
        {!device.online && (
          <span className="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-500 dark:bg-gray-900 dark:text-gray-400">
            Offline
          </span>
        )}
      </div>

      <div>
        <h4 className="text-sm font-bold text-gray-900 dark:text-white">{device.name}</h4>
        <p className="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{device.reading}</p>
      </div>

      <div className="mt-auto flex items-center justify-between">
        <span
          className={cn(
            "inline-flex items-center gap-1.5 text-xs font-semibold capitalize",
            isOn ? "text-emerald-600 dark:text-emerald-400" : "text-gray-400 dark:text-gray-500"
          )}
        >
          <span className={cn("h-1.5 w-1.5 rounded-full", isOn ? "bg-emerald-500" : "bg-gray-300 dark:bg-gray-700")} aria-hidden />
          {status}
        </span>

        {toggleable && (
          <button
            onClick={handleToggle}
            aria-label={`Toggle ${device.name}`}
            aria-pressed={isOn}
            className={cn(
              "relative h-6 w-11 rounded-full transition-colors",
              isOn ? "bg-[var(--color-primary)]" : "bg-gray-200 dark:bg-gray-800"
            )}
          >
            <span
              className={cn(
                "absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-all",
                isOn ? "left-[22px]" : "left-0.5"
              )}
            />
          </button>
        )}

        {device.type === "lock" && (
          <span className="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-500 dark:text-gray-400">
            {status === "locked" ? (
              <Lock size={14} aria-hidden />
            ) : (
              <LockOpen size={14} aria-hidden />
            )}
          </span>
        )}
      </div>
    </Card>
  );
}
