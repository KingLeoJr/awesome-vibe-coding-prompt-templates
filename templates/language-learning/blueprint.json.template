  "data_models": [
    {
      "name": "User",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "email", "type": "string", "required": true },
        { "name": "nativeLanguage", "type": "string", "required": true },
        { "name": "targetLanguage", "type": "string", "required": true },
        { "name": "proficiencyLevel", "type": "enum(beginner|intermediate|advanced|fluent)", "required": true, "default": "beginner" },
        { "name": "learningGoals", "type": "string[]", "required": false }
      ]
    },
    {
      "name": "Lesson",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "title", "type": "string", "required": true },
        { "name": "language", "type": "string", "required": true },
        { "name": "level", "type": "enum(beginner|intermediate|advanced)", "required": true },
        { "name": "duration", "type": "string", "required": true },
        { "name": "resources", "type": "string[]", "required": false },
        { "name": "completed", "type": "boolean", "required": true, "default": false }
      ]
    },
    {
      "name": "VocabularyWord",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "word", "type": "string", "required": true },
        { "name": "translation", "type": "string", "required": true },
        { "name": "exampleSentence", "type": "string", "required": false },
        { "name": "timesSeen", "type": "integer", "required": true, "default": 0 },
        { "name": "timesCorrect", "type": "integer", "required": true, "default": 0 },
        { "name": "nextReview", "type": "datetime", "required": true }
      ]
    },
    {
      "name": "Progress",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "userId", "type": "uuid", "required": true },
        { "name": "lessonsCompleted", "type": "integer", "required": true, "default": 0 },
        { "name": "currentStreak", "type": "integer", "required": true, "default": 0 },
        { "name": "longestStreak", "type": "integer", "required": true, "default": 0 },
        { "name": "averageSessionLength", "type": "integer", "required": true, "default": 0 }
      ]
    },
    {
      "name": "SpeakingPrompt",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "scenario", "type": "string", "required": true },
        { "name": "instructions", "type": "string", "required": true },
        { "name": "timeoutSeconds", "type": "integer", "required": true, "default": 60 }
      ]
    }
  ],
  "integrations": [
