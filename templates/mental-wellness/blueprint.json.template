  "features": [
    { "description": "User authentication and authorization with Flask-Security for secure access", "priority": "core", "order_index": 1 },
    { "description": "User profile system with mental health goals, current stress levels, and preferred self-care activities", "priority": "core", "order_index": 2 },
    { "description": "Personalized wellness plans generated based on user profiles, preferences, and mental health assessments", "priority": "core", "order_index": 3 },
