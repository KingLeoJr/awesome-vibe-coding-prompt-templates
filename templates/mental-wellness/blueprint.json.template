  "data_models": [
    {
      "name": "User",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "email", "type": "string", "required": true },
        { "name": "mentalHealthGoals", "type": "string[]", "required": true },
        { "name": "currentStressLevel", "type": "integer", "required": true, "default": 0 },
        { "name": "preferredActivities", "type": "string[]", "required": false }
      ]
    },
    {
      "name": "MoodEntry",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "userId", "type": "uuid", "required": true },
        { "name": "moodScore", "type": "integer", "required": true, "min": 1, "max": 10 },
        { "name": "trigger", "type": "string", "required": false },
        { "name": "copingStrategy", "type": "string", "required": false },
        { "name": "note", "type": "text", "required": false },
        { "name": "recordedAt", "type": "datetime", "required": true }
      ]
    },
    {
      "name": "WellnessPlan",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "userId", "type": "uuid", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "activities", "type": "string[]", "required": true },
        { "name": "targetMood", "type": "string", "required": true },
        { "name": "createdAt", "type": "datetime", "required": true }
      ]
    },
    {
      "name": "ResourceItem",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "title", "type": "string", "required": true },
        { "name": "type", "type": "enum(article|video|meditation|exercise)", "required": true },
        { "name": "topic", "type": "string", "required": true },
        { "name": "duration", "type": "string", "required": false },
        { "name": "url", "type": "string", "required": true }
      ]
    },
    {
      "name": "ForumPost",
      "fields": [
        { "name": "id", "type": "uuid", "required": true },
        { "name": "userId", "type": "uuid", "required": true },
        { "name": "content", "type": "text", "required": true },
        { "name": "createdAt", "type": "datetime", "required": true },
        { "name": "likes", "type": "integer", "required": true, "default": 0 }
      ]
    }
  ],
  "integrations": [
    { "service": "OpenAI", "purpose": "Mood prediction and personalized recommendations", "config_params": { "model": "gpt-4o" } },
    { "service": "SendGrid", "purpose": "Wellness reminders and motivational messages", "config_params": { "templates": ["mood_reminder", "motivational"] } }
