    { "path": "styles/globals.css", "source": "templates/local-services-directory/styles/globals.css.template", "syntax": "mustache", "mixins": [] },
    { "path": "src/app/page.tsx", "source": "templates/local-services-directory/src/app/page.tsx.template", "syntax": "mustache", "mixins": ["_shared/Footer.tsx.template"] },
    { "path": "src/components/layout/Header.tsx", "source": "templates/local-services-directory/src/components/layout/Header.tsx.template", "syntax": "mustache", "mixins": ["_shared/ThemeToggle.tsx.template"] },
    { "path": "src/components/directory/ListingCard.tsx", "source": "templates/local-services-directory/src/components/directory/ListingCard.tsx.template", "syntax": "mustache", "mixins": ["_shared/Card.tsx.template"] },
    { "path": "src/components/directory/SearchExplorer.tsx", "source": "templates/local-services-directory/src/components/directory/SearchExplorer.tsx.template", "syntax": "mustache", "mixins": [] },
    { "path": "src/components/directory/BookingWidget.tsx", "source": "templates/local-services-directory/src/components/directory/BookingWidget.tsx.template", "syntax": "mustache", "mixins": [] },
    { "path": "src/components/directory/ReviewTimeline.tsx", "source": "templates/local-services-directory/src/components/directory/ReviewTimeline.tsx.template", "syntax": "mustache", "mixins": [] },
    { "path": "src/components/directory/ProviderDashboard.tsx", "source": "templates/local-services-directory/src/components/directory/ProviderDashboard.tsx.template", "syntax": "mustache", "mixins": [] },
    { "path": "src/data/local-services-directory.json", "source": "templates/local-services-directory/src/data/local-services-directory.json.template", "syntax": "mustache", "mixins": [] },
