"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { BarChart3, CalendarCheck, Eye, MessageSquare, Star, TrendingUp } from "lucide-react";
import type { DashboardMetrics } from "@/lib/types";

interface ProviderDashboardProps {
  metrics: DashboardMetrics;
}

const WEEKDAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

export default function ProviderDashboard({ metrics }: ProviderDashboardProps) {
  const [period, setPeriod] = useState<"week" | "month">("week");
  const max = Math.max(...metrics.weeklyBookings);

  const stats = [
    { label: "Bookings", value: metrics.bookings.toLocaleString(), delta: metrics.monthlyTrend, icon: CalendarCheck },
    { label: "Avg. rating", value: metrics.avgRating.toFixed(1), delta: 0.2, icon: Star },
    { label: "Profile views", value: metrics.views.toLocaleString(), delta: 18.6, icon: Eye },
    { label: "Response rate", value: `${metrics.responseRate}%`, delta: 4.1, icon: MessageSquare },
  ];

  return (
    <section id="providers" className="bg-gray-50 py-20 dark:bg-gray-900/50">
      <div className="mx-auto max-w-7xl px-6">
        <div className="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p className="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)]">
              For service providers
            </p>
            <h2 className="mt-3 text-3xl font-bold text-gray-900 dark:text-white">
              Track your performance in real time
            </h2>
          </div>
          <div className="flex gap-2" role="group" aria-label="Dashboard period">
            {(["week", "month"] as const).map((option) => (
              <button
                key={option}
                onClick={() => setPeriod(option)}
                aria-pressed={period === option}
                className={`rounded-lg px-4 py-1.5 text-sm font-medium capitalize transition ${
                  period === option
                    ? "bg-[var(--color-primary)] text-white"
                    : "border border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900"
                }`}
              >
                {option}
              </button>
            ))}
          </div>
        </div>

        <div className="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {stats.map((stat, index) => (
            <motion.div
              key={stat.label}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: index * 0.06 }}
              className="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950"
            >
              <div className="flex items-center justify-between">
                <span className="grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
                  <stat.icon className="h-5 w-5" aria-hidden="true" />
                </span>
                <span className="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                  <TrendingUp className="h-3.5 w-3.5" aria-hidden="true" />
                  +{stat.delta}%
                </span>
              </div>
              <p className="mt-4 text-2xl font-bold text-gray-900 dark:text-white">{stat.value}</p>
              <p className="mt-1 text-sm text-gray-500 dark:text-gray-400">{stat.label}</p>
            </motion.div>
          ))}
        </div>

        <div className="mt-6 grid gap-5 lg:grid-cols-5">
          <motion.div
            initial={{ opacity: 0, y: 16 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="rounded-2xl border border-gray-200 bg-white p-6 lg:col-span-3 dark:border-gray-800 dark:bg-gray-950"
          >
            <div className="flex items-center gap-2">
              <BarChart3 className="h-5 w-5 text-[var(--color-primary)]" aria-hidden="true" />
              <h3 className="font-semibold text-gray-900 dark:text-white">
                Bookings per day ({period})
              </h3>
            </div>
            <div className="mt-6 flex h-40 items-end gap-3">
              {metrics.weeklyBookings.map((value, index) => (
                <div key={index} className="flex flex-1 flex-col items-center gap-2">
                  <span className="text-xs font-medium text-gray-500 dark:text-gray-400">{value}</span>
                  <motion.div
                    initial={{ height: 0 }}
                    whileInView={{ height: `${(value / max) * 100}%` }}
                    viewport={{ once: true }}
                    className="w-full rounded-t-lg bg-gradient-to-t from-[var(--color-primary)] to-[var(--color-secondary)]"
                  />
                </div>
              ))}
            </div>
            <div className="mt-3 flex gap-3">
              {WEEKDAYS.map((day) => (
                <span key={day} className="flex-1 text-center text-xs text-gray-400">
                  {day}
                </span>
              ))}
            </div>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, y: 16 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            className="rounded-2xl border border-gray-200 bg-white p-6 lg:col-span-2 dark:border-gray-800 dark:bg-gray-950"
          >
            <h3 className="font-semibold text-gray-900 dark:text-white">Top services</h3>
            <ul className="mt-4 space-y-4">
              {metrics.topServices.map((service) => (
                <li key={service.name} className="flex items-center justify-between text-sm">
                  <span className="text-gray-600 dark:text-gray-300">{service.name}</span>
                  <div className="flex items-center gap-3">
                    <div className="h-1.5 w-24 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
                      <div
                        className="h-full rounded-full bg-[var(--color-secondary)]"
                        style={{ width: `${service.share}%` }}
                      />
                    </div>
                    <span className="w-8 text-right font-semibold text-gray-900 dark:text-white">
                      {service.share}%
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          </motion.div>
        </div>
      </div>
    </section>
  );
}