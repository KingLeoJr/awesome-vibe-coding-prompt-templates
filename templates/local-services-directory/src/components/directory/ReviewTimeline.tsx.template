"use client";

import { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { BadgeCheck, Star } from "lucide-react";
import type { Review } from "@/lib/types";

interface ReviewTimelineProps {
  reviews: Review[];
}

export default function ReviewTimeline({ reviews }: ReviewTimelineProps) {
  const [minRating, setMinRating] = useState(1);

  const filtered = useMemo(
    () => reviews.filter((review) => review.rating >= minRating),
    [reviews, minRating]
  );

  return (
    <section id="reviews" className="mx-auto max-w-4xl px-6 py-20">
      <div className="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="text-sm font-semibold uppercase tracking-wider text-[var(--color-primary)]">
            Proven track record
          </p>
          <h2 className="mt-3 text-3xl font-bold text-gray-900 dark:text-white">
            Ratings and reviews over time
          </h2>
        </div>
        <div className="flex gap-2" role="group" aria-label="Filter reviews by rating">
          {[1, 2, 3, 4, 5].map((rating) => (
            <button
              key={rating}
              onClick={() => setMinRating(rating)}
              aria-label={`Show reviews with at least ${rating} stars`}
              aria-pressed={minRating === rating}
              className={`rounded-lg border px-3 py-1.5 text-sm font-medium transition ${
                minRating === rating
                  ? "border-[var(--color-primary)] bg-[var(--color-primary)] text-white"
                  : "border-gray-200 text-gray-600 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-900"
              }`}
            >
              {rating}&#9733;
            </button>
          ))}
        </div>
      </div>

      <ol className="relative mt-10 space-y-8 border-l border-gray-200 pl-6 dark:border-gray-800">
        {filtered.map((review, index) => (
          <motion.li
            key={review.id}
            initial={{ opacity: 0, x: -12 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.4, delay: index * 0.05 }}
            className="relative"
          >
            <span
              className="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-[var(--color-primary)] ring-4 ring-white dark:ring-gray-950"
              aria-hidden="true"
            />
            <div className="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-900">
              <div className="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p className="font-semibold text-gray-900 dark:text-white">{review.author}</p>
                  <p className="text-sm text-gray-500 dark:text-gray-400">
                    {review.date} &middot; {review.service}
                  </p>
                </div>
                <div className="flex items-center gap-2">
                  <span className="flex items-center gap-0.5" aria-label={`${review.rating} out of 5 stars`}>
                    {Array.from({ length: 5 }).map((_, index) => (
                      <Star
                        key={index}
                        className={`h-4 w-4 ${
                          index < review.rating
                            ? "fill-amber-400 text-amber-400"
                            : "text-gray-300 dark:text-gray-700"
                        }`}
                        aria-hidden="true"
                      />
                    ))}
                  </span>
                  {review.verified && (
                    <span className="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300">
                      <BadgeCheck className="h-3.5 w-3.5" aria-hidden="true" />
                      Verified
                    </span>
                  )}
                </div>
              </div>
              <p className="mt-3 text-sm text-gray-600 dark:text-gray-300">{review.comment}</p>
            </div>
          </motion.li>
        ))}
      </ol>
    </section>
  );
}