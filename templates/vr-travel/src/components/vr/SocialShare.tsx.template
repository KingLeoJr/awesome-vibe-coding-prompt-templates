          className="flex items-center gap-2 rounded-full border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 transition"
          aria-label="Share on Twitter"
        >
          <Twitter size={18} />
          <span>Twitter</span>
        </button>

        <button
          onClick={() => onShare("linkedin")}
          className="flex items-center gap-2 rounded-full border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 transition"
          aria-label="Share on LinkedIn"
        >
          <LinkedIn size={18} />
          <span>LinkedIn</span>
        </button>

        <button
          onClick={() => onShare("github")}
          className="flex items-center gap-2 rounded-full border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900 transition"
          aria-label="Share on GitHub"
        >
          <GitHub size={18} />
