        </button>
      </div>

      <textarea
        placeholder="Share your experience..."
        value={shareText}
        className="mt-4 w-full rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-3 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] dark:text-gray-100"
