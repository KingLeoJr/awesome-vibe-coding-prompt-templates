import { motion } from "framer-motion";
import { BadgeCheck, Clock, MapPin, Package, Thermometer, Truck } from "lucide-react";
import { cn } from "@/lib/utils";
import { shipments as sampleShipments } from "@/data/{{app.slug}}.json";

export interface Shipment {
  id: string;
  product: string;
  sku: string;
  origin: string;
  destination: string;
  carrier: string;
  status: "Pending" | "In Transit" | "In Customs" | "Delivered" | "Exception";
  progress: number;
  temperatureC: number;
  humidity: number;
  eta: string;
  lastEvent: string;
  verified: boolean;
  trackingHash: string;
}

interface ShipmentCardProps {
  shipment: Shipment;
  index?: number;
  onSelect?: (shipment: Shipment) => void;
}

const statusStyles: Record<Shipment["status"], string> = {
  Pending: "bg-amber-100 text-amber-800 dark:bg-amber-500/10 dark:text-amber-400",
  "In Transit": "bg-sky-100 text-sky-800 dark:bg-sky-500/10 dark:text-sky-400",
  "In Customs": "bg-violet-100 text-violet-800 dark:bg-violet-500/10 dark:text-violet-400",
  Delivered: "bg-emerald-100 text-emerald-800 dark:bg-emerald-500/10 dark:text-emerald-400",
  Exception: "bg-rose-100 text-rose-800 dark:bg-rose-500/10 dark:text-rose-400",
};

export default function ShipmentCard({
  shipment = sampleShipments[0],
  index = 0,
  onSelect,
}: ShipmentCardProps) {
  return (
    <motion.article
      initial={{ opacity: 0, y: 24 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-40px" }}
      transition={{ duration: 0.5, delay: index * 0.08 }}
      onClick={() => onSelect?.(shipment)}
      className="group flex cursor-pointer flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:border-[var(--color-primary)]/40 hover:shadow-md dark:border-gray-800 dark:bg-gray-950"
    >
      <div className="flex items-start justify-between gap-3">
        <div className="flex items-center gap-3">
          <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
            <Package size={22} />
          </span>
          <div>
            <h3 className="font-semibold text-gray-900 dark:text-white">{shipment.product}</h3>
            <p className="text-xs text-gray-500 dark:text-gray-400">SKU {shipment.sku}</p>
          </div>
        </div>
        <span
          className={cn(
            "inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-medium",
            statusStyles[shipment.status]
          )}
        >
          {shipment.verified && <BadgeCheck size={13} />}
          {shipment.status}
        </span>
      </div>

      <div className="flex items-center justify-between gap-2 text-sm">
        <span className="flex items-center gap-1.5 text-gray-600 dark:text-gray-300">
          <MapPin size={14} className="text-[var(--color-primary)]" />
          {shipment.origin}
        </span>
        <span className="text-gray-400">→</span>
        <span className="flex items-center gap-1.5 text-gray-600 dark:text-gray-300">
          <MapPin size={14} className="text-[var(--color-secondary)]" />
          {shipment.destination}
        </span>
      </div>

      <div>
        <div className="mb-1.5 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
          <span className="font-medium text-gray-700 dark:text-gray-200">{shipment.progress}% complete</span>
          <span className="flex items-center gap-1">
            <Clock size={12} />
            ETA {shipment.eta}
          </span>
        </div>
        <div
          className="h-2 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800"
          role="progressbar"
          aria-valuenow={shipment.progress}
          aria-valuemin={0}
          aria-valuemax={100}
          aria-label={`${shipment.product} progress`}
        >
          <motion.div
            initial={{ width: 0 }}
            whileInView={{ width: `${shipment.progress}%` }}
            viewport={{ once: true }}
            transition={{ duration: 0.9, ease: "easeOut" }}
            className="h-full rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)]"
          />
        </div>
      </div>

      <div className="grid grid-cols-2 gap-2 text-xs text-gray-500 dark:text-gray-400">
        <span className="flex items-center gap-1.5 rounded-lg bg-gray-50 px-2.5 py-2 dark:bg-gray-900">
          <Truck size={13} className="text-[var(--color-primary)]" />
          {shipment.carrier}
        </span>
        <span className="flex items-center gap-1.5 rounded-lg bg-gray-50 px-2.5 py-2 dark:bg-gray-900">
          <Thermometer size={13} className="text-[var(--color-primary)]" />
          {shipment.temperatureC}°C · {shipment.humidity}% RH
        </span>
      </div>

      <p className="text-xs leading-relaxed text-gray-500 dark:text-gray-400">
        {shipment.lastEvent}
      </p>

      <div className="mt-auto flex items-center justify-between border-t border-gray-100 pt-3 text-xs text-gray-400 dark:border-gray-800">
        <span className="font-mono">{shipment.trackingHash}</span>
        <span className="inline-flex items-center gap-1 font-medium text-[var(--color-primary)] opacity-0 transition group-hover:opacity-100">
          View on-chain <Truck size={13} />
        </span>
      </div>
    </motion.article>
  );
}