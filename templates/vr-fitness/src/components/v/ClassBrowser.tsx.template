"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { Filter, ChevronDown, ChevronUp } from "lucide-react";

interface ClassBrowserProps {
  categories: string[];
  filteredClasses: any[];
  onFilterChange: (category: string) => void;
}

export default function ClassBrowser({ categories, filteredClasses, onFilterChange }: ClassBrowserProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5, delay: 0.1 }}
      className="space-y-6"
    >
      <div className="flex flex-col sm:flex-row gap-4">
        <div className="w-full sm:w-48">
          <div className="space-y-2">
            {categories.map((cat, i) => (
              <button
                key={cat}
                onClick={() => onFilterChange(cat)}
                className={cn2(
                  "flex items-center justify-between rounded-md border px-3 py-2 text-sm font-medium transition-colors",
                  "border-gray-300 dark:border-gray-700",
                  filteredClasses.category === cat
                    ? "bg-[var(--color-primary)] text-white"
                    : "text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-900"
                )}
                aria-selected={filteredClasses.category === cat}
              >
                {cat}
                {filteredClasses.category === cat ? <ChevronUp size={12} /> : <ChevronDown size={12} />}
              </button>
            ))}
          </div>
        </div>

        <div className="flex-1">
          <p className="text-sm text-gray-500 dark:text-gray-400">Filter by type</p>
          <div className="space-y-1">
            {filteredClasses.map((_class, i) => (
              <motion.div
                key={_class.id}
                initial={{ opacity: 0, x: -20 }}
                whileInView={{ opacity: 1, x: 0 }}
                transition={{ duration: 0.3, delay: i * 0.03 }}
                className="flex items-center gap-3 rounded-xl border p-3 border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-950 hover:bg-gray-50 dark:hover:bg-gray-950 transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  className="h-5 w-5 text-[var(--color-primary)]"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12 15l-3.87 1.34 1.42 4.78 3.52-2.16 1.07.87-3.09-4.09a1 1 0 0 0-1.08-.01L10.5 8.51 7.07 5.12a1 1 0 0 0-1.58.88l-2.23 2.06 1.17 3.78 3.02-1.76a1 1 0 0 0-.28-1.28z" />
                  <path d="M15.54 7.46a1 1 0 0 1 1.06 1.43l1.33 4.38a1 1 0 0 1-.88 1.05H16a1 1 0 0 1 0 2h-1.16l-1.25 4.27a1 1 0 0 1-1.8 1.09H9.66l-1.25-4.27a1 1 0 0 1-1.8-1.09H5a1 1 0 0 1 0-2h1.09l.83-2.85a1 1 0 0 1 1.06-1.42l1.34-4.43 2.57 1.06a1 1 0 0 1 1.25.87l2.56-1.06 1.33 4.38a1 1 0 0 1 1.06 1.43h1.33z" />
                </svg>
                <div>
                  <h4 className="font-medium text-gray-900 dark:text-white">{_class.title}</h4>
                  <p className="text-xs text-gray-500 dark:text-gray-400">{_class.type} • {_class.duration} min</p>
                </div>
              </motion.div>
            ))}
          </div>
        </div>
      </div>
    </motion.div>
  );
}