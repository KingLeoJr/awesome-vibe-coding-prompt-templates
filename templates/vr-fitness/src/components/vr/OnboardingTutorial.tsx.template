"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { useState } from "react";
import { Check, Menu } from "lucide-react";

interface OnboardingStep {
  id: string;
  title: string;
  description: string;
}

interface OnboardingTutorialProps {
  steps: OnboardingStep[];
  onComplete: () => void;
}

export default function OnboardingTutorial({ steps, onComplete }: OnboardingTutorialProps) {
  const [currentStep, setCurrentStep] = useState(0);

  const handleNext = () => setCurrentStep((c) => c + 1);
  const handlePrev = () => setCurrentStep((c) => c - 1);

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5, delay: 0.1 }}
      className="max-w-3xl mx-auto pt-8"
    >
      <div className="bg-white dark:bg-gray-950 rounded-2xl p-8 shadow-lg">
        <div className="flex items-center justify-between mb-6">
          <h2 className="font-bold text-2xl text-gray-900 dark:text-white">Get Started</h2>
          <button onClick={onComplete} className="text-sm text-[var(--color-primary)] hover:underline">
            Skip
          </button>
        </div>

        {steps.map((step, i) => (
          <motion.div
            key={step.id}
            initial={{ opacity: 0, x: -20 }}
            whileInView={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.4, delay: i * 0.1 }}
            className="space-y-4"
          >
            <div className="w-12 h-12 rounded-full flex items-center justify-center mx-auto flex-shrink-0" style={{ backgroundColor: "var(--color-primary)" }}>
              <Check size={32} className="text-white" />
            </div>

            <h3 className="font-bold text-gray-900 dark:text-white">{step.title}</h3>
            <p className="text-gray-500 dark:text-gray-400">{step.description}</p>

            {i < steps.length - 1 ? (
              <div className="flex items-center justify-between">
                <button
                  onClick={() => setCurrentStep(i - 1)}
                  className="text-sm text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-400"
                  aria-label="Previous step"
                >
                  Previous
                </button>
                <button
                  onClick={() => setCurrentStep(i + 1)}
                  className="text-sm text-[var(--color-primary)] hover:underline"
                  aria-label="Next step"
                >
                  Next
                </button>
              </div>
            ) : (
              <button
                onClick={onComplete}
                className="mt-4 w-full rounded-md border border-[var(--color-primary)] px-4 py-2 text-sm font-medium text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition"
                aria-label="Complete onboarding"
              >
                Get Started
              </button>
            )}
          </motion.div>
        ))}
      </div>
    </motion.div>
  );
}