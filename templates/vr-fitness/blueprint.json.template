    { "path": "blueprint.json", "source": "templates/vr-fitness/blueprint.json.template", "syntax": "mustache" },
    { "path": "prompt.md", "source": "templates/vr-fitness/prompt.md.template", "syntax": "mustache" },
    { "path": "config/site.config.ts", "source": "templates/vr-fitness/config/site.config.ts.template", "syntax": "mustache" },
    { "path": "package.json", "source": "templates/vr-fitness/package.json.template", "syntax": "mustache" },
    { "path": "styles/globals.css", "source": "templates/vr-fitness/styles/globals.css.template", "syntax": "mustache" },
    { "path": "src/app/page.tsx", "source": "templates/vr-fitness/src/app/page.tsx.template", "syntax": "mustache" },
    { "path": "src/components/layout/Header.tsx", "source": "templates/vr-fitness/src/components/layout/Header.tsx.template", "syntax": "mustache", "mixins": ["_shared/ThemeToggle.tsx.template"] },
    { "path": "src/components/vr/WorkoutLobby.tsx", "source": "templates/vr-fitness/src/components/vr/WorkoutLobby.tsx.template", "syntax": "mustache" },
    { "path": "src/components/vr/ImmersiveSession.tsx", "source": "templates/vr-fitness/src/components/vr/ImmersiveSession.tsx.template", "syntax": "mustache" },
    { "path": "src/components/vr/PerformanceMetrics.tsx", "source": "templates/vr-fitness/src/components/vr/PerformanceMetrics.tsx.template", "syntax": "mustache" },
    { "path": "src/components/vr/ClassBrowser.tsx", "source": "templates/vr-fitness/src/components/vr/ClassBrowser.tsx.template", "syntax": "mustache" },
    { "path": "src/components/vr/SocialFeed.tsx", "source": "templates/vr-fitness/src/components/vr/SocialFeed.tsx.template", "syntax": "mustache" },
    { "path": "src/components/vr/OnboardingTutorial.tsx", "source": "templates/vr-fitness/src/components/vr/OnboardingTutorial.tsx.template", "syntax": "mustache" },
    { "path": "src/data/vr-fitness.json", "source": "templates/vr-fitness/src/data/vr-fitness.json.template", "syntax": "mustache" }
  ],
