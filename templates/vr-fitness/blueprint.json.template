{
  "blueprint_id": "vr-fitness-0001",
  "slug": "vr-fitness",
  "name": "Virtual Reality (VR) Fitness Training Platform",
  "category": "Specialized",
  "archetype": "ImmersiveXR",
  "tagline": "Immersive VR fitness classes to achieve your health goals",
  "builder_prompt_source": "prompts/vr-fitness.md",
  "tech_stack": [
    { "layer": "frontend", "technology": "React + Next.js 15", "version_hint": "15.x", "purpose": "Responsive marketing + VR dashboard shell" },
    { "layer": "backend", "technology": "Node.js", "version_hint": "", "purpose": "REST API, workout logic, realtime sync" },
    { "layer": "database", "technology": "PostgreSQL", "version_hint": "16.x", "purpose": "Users, workouts, sessions, progress, profiles" },
    { "layer": "auth", "technology": "OAuth 2.0 / OpenID Connect", "version_hint": "", "purpose": "Secure user authentication and authorization" },
    { "layer": "state", "technology": "Redux Toolkit", "version_hint": "2.x", "purpose": "Complex application state management" },
    { "layer": "ui", "technology": "Tailwind CSS", "version_hint": "3.4.x", "purpose": "Modern, accessible, dark-mode UI" },
    { "layer": "animation", "technology": "Framer Motion", "version_hint": "11.x", "purpose": "Micro-interactions and section reveals" },
    { "layer": "3d", "technology": "Three.js / WebGL", "version_hint": "", "purpose": "3D environments and VR rendering" },
    { "layer": "payments", "technology": "Stripe", "version_hint": "", "purpose": "Subscription fees and class purchases" },
    { "layer": "wearables", "technology": "Fitbit / Apple Watch APIs", "version_hint": "", "purpose": "Real-time health data syncing during workouts" },
    { "layer": "api", "technology": "Custom REST API", "version_hint": "", "purpose": "Third-party developer integration (health apps)" }
  ],
  "features": [
    { "description": "Implement user authentication and authorization using OAuth 2.0 for secure access", "priority": "core", "order_index": 1 },
    { "description": "Design an immersive UI using WebGL and 3D graphics to enhance user engagement and interaction", "priority": "core", "order_index": 2 },
    { "description": "Use Redux for state management to handle complex application states effectively", "priority": "core", "order_index": 3 },
    { "description": "Create a library of VR fitness classes that users can participate in, including yoga, HIIT, dance, and strength training", "priority": "core", "order_index": 4 },
    { "description": "Implement a personalized training program generator that tailors workouts based on user fitness levels, goals, and preferences", "priority": "core", "order_index": 5 },
    { "description": "Design interactive environments for workouts, such as beaches, forests, or gyms, to enhance motivation and enjoyment during sessions", "priority": "core", "order_index": 6 },
    { "description": "Create a social feature that allows users to invite friends to join workouts in VR or compete in challenges together", "priority": "core", "order_index": 7 },
    { "description": "Implement a progress tracking system that monitors user performance metrics like calories burned, workout duration, and strength improvements", "priority": "core", "order_index": 8 },
    { "description": "Design an analytics dashboard that provides insights into user activity, progress over time, and achievement of fitness goals", "priority": "core", "order_index": 9 },
    { "description": "Create partnerships with certified fitness trainers to offer live-streamed classes or one-on-one coaching sessions in VR", "priority": "enhanced", "order_index": 10 },
    { "description": "Implement a secure payment processing system using Stripe or PayPal integration for subscription fees or individual class purchases", "priority": "enhanced", "order_index": 11 },
    { "description": "Design an educational resource center with articles, videos, and tools about fitness techniques, nutrition tips, and wellness practices", "priority": "enhanced", "order_index": 12 },
    { "description": "Create integration with wearable devices (Fitbit, Apple Watch) for real-time health data syncing during workouts", "priority": "enhanced", "order_index": 13 },
    { "description": "Design an onboarding process with tutorials guiding new users through platform features and VR setup instructions", "priority": "enhanced", "order_index": 14 },
    { "description": "Create a referral program that rewards users for inviting friends to join the platform or complete challenges together", "priority": "enhanced", "order_index": 15 },
    { "description": "Implement personalized notifications for workout reminders, class schedules, and wellness tips based on user preferences", "priority": "enhanced", "order_index": 16 },
    { "description": "Design an interactive calendar feature that allows users to schedule workouts and track their fitness activities in advance", "priority": "enhanced", "order_index": 17 },
    { "description": "Create a feedback system allowing users to rate classes and provide suggestions for improvement to trainers", "priority": "enhanced", "order_index": 18 },
    { "description": "Implement gamification elements like achievements, leaderboards, and virtual rewards to motivate users to engage regularly with the platform", "priority": "enhanced", "order_index": 19 },
    { "description": "Design a live chat feature connecting users with trainers during workouts for real-time support and guidance", "priority": "enhanced", "order_index": 20 },
    { "description": "Create an impact reporting feature highlighting the benefits of VR fitness training compared to traditional methods through data analytics", "priority": "enhanced", "order_index": 21 },
    { "description": "Implement advanced search functionality allowing users to filter classes by type (cardio, strength), duration, or intensity level", "priority": "enhanced", "order_index": 22 },
    { "description": "Design user profiles where customers can manage their fitness data, preferences, subscriptions, and payment methods effectively", "priority": "enhanced", "order_index": 23 },
    { "description": "Create integration with popular health apps (MyFitnessPal) for seamless nutrition tracking alongside workout routines", "priority": "enhanced", "order_index": 24 },
    { "description": "Implement push notifications for new class launches or special events within the app", "priority": "enhanced", "order_index": 25 },
    { "description": "Design an interactive quiz to assess users' knowledge about fitness practices and techniques", "priority": "advanced", "order_index": 26 },
    { "description": "Create a motivational quotes section that updates daily to inspire users in their fitness journeys", "priority": "advanced", "order_index": 27 },
    { "description": "Implement data analytics to personalize recommendations based on user behavior and preferences", "priority": "advanced", "order_index": 28 },
    { "description": "Create a custom API for third-party developers to integrate with the platform (e.g., health apps)", "priority": "advanced", "order_index": 29 },
    { "description": "Design an event calendar highlighting upcoming live classes or special guest trainers in the fitness industry", "priority": "advanced", "order_index": 30 },
    { "description": "Implement a loyalty program where frequent users earn rewards or discounts on future classes", "priority": "advanced", "order_index": 31 },
    { "description": "Create multi-language support to cater to a diverse global audience", "priority": "advanced", "order_index": 32 },
    { "description": "Design accessibility features ensuring compliance with WCAG standards for inclusive VR fitness", "priority": "advanced", "order_index": 33 }
  ],
  "sections": [
    { "name": "Dashboard", "component_path": "src/components/vr/WorkoutLobby.tsx", "layout_type": "dashboard", "is_visible": true, "order_index": 1 },
    { "name": "Classes", "component_path": "src/components/vr/ClassBrowser.tsx", "layout_type": "grid", "is_visible": true, "order_index": 2 },
    { "name": "Session", "component_path": "src/components/vr/ImmersiveSession.tsx", "layout_type": "immersive", "is_visible": true, "order_index": 3 },
    { "name": "Progress", "component_path": "src/components/vr/PerformanceMetrics.tsx", "layout_type": "dashboard", "is_visible": true, "order_index": 4 },
    { "name": "Social", "component_path": "src/components/vr/SocialFeed.tsx", "layout_type": "social", "is_visible": true, "order_index": 5 },
    { "name": "Onboarding", "component_path": "src/components/vr/OnboardingTutorial.tsx", "layout_type": "onboarding", "is_visible": true, "order_index": 6 }
  ],
  "components": [
    { "name": "Header", "path": "src/components/layout/Header.tsx", "props": { "brandName": "string", "navItems": "NavItem[]", "ctaText": "string", "ctaHref": "string", "isFixed": "boolean" }, "mixins": ["_shared/ThemeToggle.tsx.template"] },
    { "name": "WorkoutLobby", "path": "src/components/vr/WorkoutLobby.tsx", "props": { "classes": "VRFitnessClass[]", "onSelect": "fn", "userLevel": "string" } },
    { "name": "ImmersiveSession", "path": "src/components/vr/ImmersiveSession.tsx", "props": { "currentClass": "VRFitnessClass", "progress": "WorkoutProgress", "onComplete": "fn" } },
    { "name": "PerformanceMetrics", "path": "src/components/vr/PerformanceMetrics.tsx", "props": { "workouts": "WorkoutSession[]", "caloriesBurned": "number", "improvements": "StrengthImprovement[]" } },
    { "name": "ClassBrowser", "path": "src/components/vr/ClassBrowser.tsx", "props": { "categories": "string[]", "filteredClasses": "VRFitnessClass[]", "onFilterChange": "fn" } },
    { "name": "SocialFeed", "path": "src/components/vr/SocialFeed.tsx", "props": { "challenges": "Challenge[]", "recentActivities": "Activity[]", "userLeaderboard": "LeaderboardEntry[]" } },
    { "name": "OnboardingTutorial", "path": "src/components/vr/OnboardingTutorial.tsx", "props": { "steps": "OnboardingStep[]", "onComplete": "fn" } },
    { "name": "Footer", "path": "src/components/shared/Footer.tsx", "props": { "name": "string", "description": "string" }, "mixins": ["_shared/Footer.tsx.template"] }
  ],
  "data_models": [
    { "name": "User", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "fitnessLevel", "type": "enum(beginner|intermediate|advanced)", "required": true }, { "name": "preferredCategories", "type": "string[]", "required": false }, { "name": "onboarded", "type": "boolean", "required": true, "default": false } ] },
    { "name": "VRFitnessClass", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "type", "type": "enum(yoga|HIIT|dance|strength|cardio)", "required": true }, { "name": "duration", "type": "integer", "required": true }, { "name": "difficulty", "type": "enum(beginners|intermediate|advanced)", "required": true }, { "name": "environment", "type": "enum(beach|forest|gym|city|space)", "required": true }, { "name": "caloriesPerMinute", "type": "number", "required": true }, { "name": "imageUrl", "type": "string", "required": false }, { "name": "isFeatured", "type": "boolean", "required": true, "default": false } ] },
    { "name": "WorkoutSession", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "userId", "type": "uuid", "required": true }, { "name": "classId", "type": "uuid", "required": true }, { "name": "startedAt", "type": "date", "required": true }, { "name": "completedAt", "type": "date", "required": false }, { "name": "caloriesBurned", "type": "number", "required": true }, { "name": "averageHeartRate", "type": "number", "required": false }, { "name": "completed", "type": "boolean", "required": true, "default": false } ] },
    { "name": "ProgressRecord", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "userId", "type": "uuid", "required": true }, { "name": "totalWorkouts", "type": "integer", "required": true }, { "name": "totalCaloriesBurned", "type": "number", "required": true }, { "name": "longestSession", "type": "integer", "required": true }, { "name": "achievementsUnlocked", "type": "string[]", "required": false } ] },
    { "name": "Challenge", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "description", "type": "string", "required": true }, { "name": "target", "type": "integer", "required": true }, { "name": "current", "type": "integer", "required": true, "default": 0 }, { "name": "reward", "type": "string", "required": false } ] },
    { "name": "OnboardingStep", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "description", "type": "string", "required": true }, { "name": "completed", "type": "boolean", "required": true, "default": false } ] },
    { "name": "StrengthImprovement", "fields": [ { "name": "exercise", "type": "string", "required": true }, { "name": "previous1RM", "type": "number", "required": false }, { "name": "current1RM", "type": "number", "required": false }, { "name": "progressPercent", "type": "number", "required": true } ] },
    { "name": "LeaderboardEntry", "fields": [ { "name": "rank", "type": "integer", "required": true }, { "name": "userId", "type": "uuid", "required": true }, { "name": "totalXP", "type": "integer", "required": true }, { "name": "streakDays", "type": "integer", "required": true } ] }
  ],
  "integrations": [
    { "service": "Fitbit API", "purpose": "Real-time heart rate, calories, and activity data syncing during workouts", "config_params": { "scope": "activity heart_rate sleep" } },
    { "service": "Apple Health API", "purpose": "Real-time health data syncing for Apple Watch users", "config_params": { "sync": "workouts calories heart_rate" } },
    { "service": "Stripe", "purpose": "Secure payment processing for subscription fees and individual class purchases", "config_params": { "billing_interval": "monthly" } },
    { "service": "OAuth 2.0 / OpenID Connect provider", "purpose": "Secure user authentication and authorization", "config_params": { "flows": ["authorization_code", "pkce"] } },
    { "service": "MyFitnessPal API", "purpose": "Seamless nutrition tracking alongside workout routines", "config_params": { "integration": "food_exercise" } }
  ],
  "nfrs": [
    { "type": "Security", "requirement": "OAuth 2.0 with PKCE; sensitive health data encrypted at rest (AES-256) and in transit (TLS 1.3)" },
    { "type": "Performance", "requirement": "Workout session renders in under 2s on mid-range mobile; 3D environments load progressively" },
    { "type": "Responsive", "requirement": "Full responsive layout from 320px phones to 4K desktop monitors; VR environments adapt to screen size" },
    { "type": "Accessibility", "requirement": "WCAG 2.1 AA; semantic landmarks, aria-labels on interactive elements, reduced-motion support for non-VR users" },
    { "type": "i18n", "requirement": "Multi-language support with ICU message catalogs; UI text flows right-to-left compatible" },
    { "type": "SEO", "requirement": "Server-rendered marketing shell with Open Graph tags and JSON-LD schema for fitness services" },
    { "type": "Testing", "requirement": "Unit tests for state management, component tests for workout flow, integration tests for wearable sync" }
  ],
  "design_tokens": [
    { "token_type": "color", "token_name": "color.primary", "token_value": "#10b981" },
    { "token_type": "color", "token_name": "color.secondary", "token_value": "#3b82f6" },
    { "token_type": "color", "token_name": "color.accent", "token_value": "#f59e0b" },
