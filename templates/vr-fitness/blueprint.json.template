    { "token_type": "color", "token_name": "color.secondary_dark", "token_value": "#60a5fa" },
    { "token_type": "color", "token_name": "color.accent_dark", "token_value": "#fbbf24" },
    { "token_type": "font", "token_name": "font.sans", "token_value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    { "token_type": "font", "token_name": "font.mono", "token_value": "ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace" },
    { "token_type": "radius", "token_name": "radius.card", "token_value": "1rem" },
    { "token_type": "mode", "token_name": "mode.dark", "token_value": "class" }
  ],
  "deployment": [
    { "platform": "Vercel", "config": { "framework": "nextjs", "url": "{{deployment.url}}", "analytics_id": "{{deployment.analytics_id}}" } },
    { "platform": "Railway", "config": { "service": "node-api", "env": "production" } }
  ],
  "template_files": [
