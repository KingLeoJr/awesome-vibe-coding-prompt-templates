    { "name": "Review", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "product_id", "type": "uuid", "required": true }, { "name": "author", "type": "string", "required": true }, { "name": "rating", "type": "integer", "required": true }, { "name": "title", "type": "string", "required": false }, { "name": "body", "type": "text", "required": true }, { "name": "date", "type": "date", "required": true }, { "name": "verified", "type": "boolean", "required": false, "default": false } ] },
