import { motion } from "framer-motion";
import { ArrowUpRight, BarChart3, Droplets, Layers, TrendingUp } from "lucide-react";
import { pools as samplePools } from "@/data/{{app.slug}}.json";

export interface LiquidityPool {
  id: string;
  pair: string;
  symbolA: string;
  symbolB: string;
  tvlUsd: number;
  apr: number;
  volume24h: number;
  feeTier: number;
  change24h: number;
}

interface LiquidityPoolProps {
  pools?: LiquidityPool[];
  locale?: string;
  currency?: string;
}

export default function LiquidityPool({
  pools = samplePools,
  locale = "{{i18n.default_locale}}",
  currency = "{{i18n.currency}}",
}: LiquidityPoolProps) {
  const usd = (value: number) =>
    new Intl.NumberFormat(locale, {
      style: "currency",
      currency,
      notation: "compact",
      maximumFractionDigits: 1,
    }).format(value);

  return (
    <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {pools.map((pool, index) => (
        <motion.article
          key={pool.id}
          initial={{ opacity: 0, y: 24 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-40px" }}
          transition={{ duration: 0.5, delay: index * 0.07 }}
          className="flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-6 transition hover:border-[var(--color-primary)]/40 hover:shadow-md dark:border-gray-800 dark:bg-gray-950"
        >
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
                <Droplets size={21} />
              </span>
              <div>
                <h3 className="font-semibold text-gray-900 dark:text-white">{pool.pair}</h3>
                <p className="text-xs text-gray-500 dark:text-gray-400">
                  {pool.symbolA} / {pool.symbolB} · {pool.feeTier}% fee
                </p>
              </div>
            </div>
            <span className="inline-flex items-center gap-1 rounded-full bg-[var(--color-accent)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--color-accent)]">
              <TrendingUp size={12} />
              {pool.change24h > 0 ? "+" : ""}
              {pool.change24h}%
            </span>
          </div>

          <div className="grid grid-cols-3 gap-2 rounded-2xl bg-gray-50 p-4 text-center dark:bg-gray-900">
            <div>
              <p className="text-[11px] uppercase tracking-wide text-gray-400">TVL</p>
              <p className="mt-0.5 text-sm font-bold text-gray-900 dark:text-white">{usd(pool.tvlUsd)}</p>
            </div>
            <div>
              <p className="text-[11px] uppercase tracking-wide text-gray-400">APR</p>
              <p className="mt-0.5 text-sm font-bold text-[var(--color-accent)]">{pool.apr.toFixed(2)}%</p>
            </div>
            <div>
              <p className="text-[11px] uppercase tracking-wide text-gray-400">Vol 24h</p>
              <p className="mt-0.5 text-sm font-bold text-gray-900 dark:text-white">{usd(pool.volume24h)}</p>
            </div>
          </div>

          <div className="mt-auto flex items-center justify-between border-t border-gray-100 pt-3 text-xs text-gray-400 dark:border-gray-800">
            <span className="inline-flex items-center gap-1.5">
              <BarChart3 size={13} className="text-[var(--color-secondary)]" />
              AMM pool · {pool.symbolA} base
            </span>
            <span className="inline-flex items-center gap-1 font-medium text-[var(--color-primary)]">
              Provide <ArrowUpRight size={13} />
            </span>
          </div>
        </motion.article>
      ))}

      <motion.a
        initial={{ opacity: 0, y: 24 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5, delay: 0.28 }}
        href="#pools"
        className="flex min-h-[200px] flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-gray-300 text-gray-400 transition hover:border-[var(--color-primary)]/50 hover:text-[var(--color-primary)] dark:border-gray-700"
      >
        <span className="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-primary)]/10">
          <Layers size={22} />
        </span>
        <span className="text-sm font-medium">Create a liquidity pool</span>
      </motion.a>
    </div>
  );
}