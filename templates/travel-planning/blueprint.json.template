  "data_models": [
    { "name": "User", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "preferences", "type": "string[]" }, { "name": "travelHistory", "type": "object[]" } ] },
