"use client";

import { motion } from "framer-motion";
import { DollarSign, Shield, ChartBar } from "lucide-react";
import { cn } from "@/lib-utils";

interface CostEstimatorProps {
  serviceType: string;
  budget: number;
}

export default function CostEstimator({ serviceType, budget }: CostEstimatorProps) {
  const costData: Record<string, { min: number; max: number }> = {
    grooming: { min: 30, max: 90 },
    training: { min: 50, max: 150 },
    boarding: { min: 40, max: 120 },
    walking: { min: 15, max: 45 },
  };

  const range = costData[serviceType] || { min: 25, max: 75 };
  const estimatedCost = Math.random() * (range.max - range.min) + range.min;
  const remainingBudget = budget - estimatedCost;

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="space-y-6"
    >
      <div className="p-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950">
        <div className="grid grid-cols-2 gap-4">
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Service</p>
            <p className="text-2xl font-bold text-gray-900 dark:text-white">{serviceType.charAt(0).toUpperCase() + serviceType.slice(1)}</p>
          </div>
          <div>
            <p className="text-xs text-gray-500 dark:text-gray-400">Estimated cost</p>
            <p className="text-2xl font-bold text-[var(--color-primary)]">${estimatedCost.toFixed(2)}</p>
          </div>
        </div>

        <div className="mt-4">
          <p className="text-sm text-gray-500 dark:text-gray-400">Your budget: ${budget}</p>
          <div className="mt-2 h-2 rounded-full bg-gray-200 dark:bg-gray-700 overflow-hidden">
            <div
              className="h-full rounded-full bg-[var(--color-primary)] transition-width"
              style={{ width: `${remainingBudget >= 0 ? (estimatedCost / budget) * 100 : 0}%` }}
            />
          </div>
          <p className="text-xs mt-1 text-gray-600 dark:text-gray-400">
            {remainingBudget >= 0 ? `Remaining: $${remainingBudget.toFixed(2)}` : "Over budget"}
          </p>
        </div>

        <div className="mt-6 p-4 rounded bg-gray-50 dark:bg-gray-800">
          <ChartBar className="h-4 w-4 text-[var(--color-primary)] mr-2" /> <span>Typical price range: ${range.min} - ${range.max}</span>
        </div>
      </div>
    </motion.div>
  );
}