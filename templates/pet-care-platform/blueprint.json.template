  "data_models": [
    { "name": "User", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "petDetails", "type": "object", "required": false }, { "name": "ownerPreferences", "type": "string[]", "required": false } ] },
    { "name": "PetInfo", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "type", "type": "enum(dog|cat|bird|small_animal|exotic)", "required": true }, { "name": "breed", "type": "string", "required": false }, { "name": "age", "type": "integer", "required": false }, { "name": "medicalHistory", "type": "string", "required": false }, { "name": "specialNeeds", "type": "string", "required": false } ] },
    { "name": "ServiceProvider", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "type", "type": "enum(groomer|trainer|vet|walker|boarding)", "required": true }, { "name": "rating", "type": "decimal", "required": true }, { "name": "priceRange", "type": "string", "required": true }, { "name": "bio", "type": "string", "required": false }, { "name": "availability", "type": "string", "required": true } ] },
    { "name": "HealthRecord", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "petId", "type": "uuid", "required": true }, { "name": "date", "type": "date", "required": true }, { "name": "vaccinationType", "type": "string", "required": true }, { "name": "vetName", "type": "string", "required": false }, { "name": "nextDueDate", "type": "date", "required": true } ] },
    { "name": "ResourceArticle", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "contentSummary", "type": "string", "required": false }, { "name": "url", "type": "string", "required": true } ] },
    { "name": "ServiceRequest", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "userId", "type": "uuid", "required": true }, { "name": "providerId", "type": "uuid", "required": true }, { "name": "serviceType", "type": "enum(grooming|training|boarding|walking)", "required": true }, { "name": "photos", "type": "string[]", "required": false }, { "name": "status", "type": "enum(pending|confirmed|completed|cancelled)", "required": true, "default": "pending" }, { "name": "createdAt", "type": "datetime", "required": true } ] }
  ],
  "integrations": [
    { "service": "JWT Auth", "purpose": "Secure user authentication and authorization", "config_params": { "token_ttl": "24h", "refresh": true } },
    { "service": "Stripe", "purpose": "Service payments and subscription plans", "config_params": { "mode": "payment_intents", "success_url": "{{deployment.url}}/payments/success", "cancel_url": "{{deployment.url}}/payments/cancel" } },
    { "service": "SendGrid", "purpose": "Welcome emails, appointment reminders, and care task notifications", "config_params": { "templates": ["welcome", "reminder", "appointment_confirmation"] } },
    { "service": "Twilio", "purpose": "SMS notifications for appointment confirmations and reminders", "config_params": {} },
    { "service": "Google Maps API", "purpose": "Location-based search for pet service providers", "config_params": { "api_key": "{{deployment.url}}" } }
  ],
  "nfrs": [
    { "type": "Security", "requirement": "JWT with short-lived access tokens + refresh rotation; passwords hashed (bcrypt); TLS 1.3 in transit; SSL encryption for all data" },
