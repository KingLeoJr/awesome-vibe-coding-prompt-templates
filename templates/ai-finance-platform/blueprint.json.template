  "data_models": [
    { "name": "User", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "email", "type": "string", "required": true }, { "name": "financialGoals", "type": "string[]", "required": false }, { "name": "incomeSources", "type": "object[]", "required": false }, { "name": "expenseCategories", "type": "string[]", "required": false } ] },
    { "name": "Account", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "type", "type": "enum(chequing|savings|credit|investment)", "required": true }, { "name": "balance", "type": "decimal", "required": true }, { "name": "currency", "type": "string", "required": true } ] },
    { "name": "Transaction", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "date", "type": "date", "required": true }, { "name": "merchant", "type": "string", "required": true }, { "name": "category", "type": "string", "required": true }, { "name": "amount", "type": "decimal", "required": true }, { "name": "type", "type": "enum(income|expense)", "required": true } ] },
    { "name": "Budget", "fields": [ { "name": "category", "type": "string", "required": true }, { "name": "monthlyLimit", "type": "decimal", "required": true }, { "name": "spent", "type": "decimal", "required": true }, { "name": "recommended", "type": "decimal", "required": false } ] },
    { "name": "SavingsGoal", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "target", "type": "decimal", "required": true }, { "name": "saved", "type": "decimal", "required": true }, { "name": "deadline", "type": "date", "required": false }, { "name": "autoAllocate", "type": "boolean", "required": false } ] },
    { "name": "Debt", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "balance", "type": "decimal", "required": true }, { "name": "apr", "type": "decimal", "required": true }, { "name": "minPayment", "type": "decimal", "required": true }, { "name": "payoffStrategy", "type": "enum(snowball|avalanche)", "required": false }, { "name": "estimatedPayoff", "type": "date", "required": false } ] },
    { "name": "PortfolioHolding", "fields": [ { "name": "symbol", "type": "string", "required": true }, { "name": "name", "type": "string", "required": true }, { "name": "shares", "type": "decimal", "required": true }, { "name": "value", "type": "decimal", "required": true }, { "name": "change", "type": "decimal", "required": false } ] },
    { "name": "LearningResource", "fields": [ { "name": "id", "type": "uuid", "required": true }, { "name": "title", "type": "string", "required": true }, { "name": "type", "type": "enum(article|video|tool)", "required": true }, { "name": "duration", "type": "string", "required": false }, { "name": "level", "type": "enum(beginner|intermediate|advanced)", "required": true }, { "name": "url", "type": "string", "required": true } ] }
  ],
  "integrations": [
    { "service": "Plaid", "purpose": "Real-time bank account aggregation and transaction sync", "config_params": { "env": "sandbox", "products": ["transactions", "auth", "liabilities"] } },
    { "service": "Stripe", "purpose": "Premium subscriptions and secure payment processing", "config_params": { "billing_interval": "monthly" } },
    { "service": "QuickBooks", "purpose": "Two-way accounting software sync", "config_params": { "scope": "accounting.transactions" } },
    { "service": "Xero", "purpose": "Accounting data import/export", "config_params": { "scope": "accounting.contacts,accounting.transactions" } },
    { "service": "OAuth 2.0 / OpenID Connect provider", "purpose": "Secure authentication and authorization", "config_params": { "flows": ["authorization_code", "pkce"] } },
    { "service": "OpenAI", "purpose": "AI budget recommendations and spending insights", "config_params": { "model": "gpt-4o" } }
  ],
  "nfrs": [
    { "type": "Security", "requirement": "OAuth 2.0 + least-privilege roles; sensitive financial data encrypted at rest (AES-256) and in transit (TLS 1.3); PCI-DSS aligned payment handling via Stripe" },
