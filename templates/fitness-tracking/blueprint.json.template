    { "name": "Overview", "component_path": "src/components/fitness/ActivityRing.tsx", "layout_type": "dashboard", "order_index": 1 },
    { "name": "Activity", "component_path": "src/components/fitness/WeeklyOverview.tsx", "layout_type": "grid", "order_index": 2 },
    { "name": "Workouts", "component_path": "src/components/fitness/WorkoutLog.tsx", "layout_type": "list", "order_index": 3 },
    { "name": "Nutrition", "component_path": "src/components/fitness/NutritionTracker.tsx", "layout_type": "list", "order_index": 4 },
    { "name": "Goals", "component_path": "src/components/fitness/AchievementBadge.tsx", "layout_type": "grid", "order_index": 5 }
