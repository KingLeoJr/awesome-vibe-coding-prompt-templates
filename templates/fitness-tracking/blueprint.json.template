    { "type": "Responsive", "requirement": "Adaptive layouts across phones, tablets, and web" },
    { "type": "Offline", "requirement": "Workouts and meals loggable offline, synced on reconnect" },
    { "type": "i18n", "requirement": "Localization for 6+ languages via Flutter intl" },
    { "type": "Testing", "requirement": "Widget/unit tests for logging flows; golden tests for key screens" }
  ],
