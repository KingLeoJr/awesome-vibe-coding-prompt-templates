    { "token_type": "spacing", "token_name": "spacing.section", "token_value": "6rem" },
    { "token_type": "mode", "token_name": "mode.dark", "token_value": "class" }
  ],
  "deployment": [
    { "platform": "Firebase Hosting", "config": { "url": "https://fitness-tracking.example.com", "target": "web-dashboard" } },
    { "platform": "Vercel", "config": { "url": "https://fitness-tracking.example.com", "framework": "Next.js" } },
