  "components": [
    { "name": "Header", "path": "src/components/layout/Header.tsx.template", "props": { "logoText": "{{app.name}}", "navItems": "sections", "ctaText": "{{header.cta_text}}", "ctaHref": "{{header.cta_href}}" }, "mixins": ["_shared/ThemeToggle.tsx.template"] },
    { "name": "Footer", "path": "src/components/layout/Footer.tsx", "props": { "name": "{{app.name}}", "navItems": "sections" }, "mixins": ["_shared/Footer.tsx.template"] },
    { "name": "ActivityRing", "path": "src/components/fitness/ActivityRing.tsx.template", "props": { "rings": "ActivityRingData[]", "size": "number", "strokeWidth": "number" } },
    { "name": "WorkoutLog", "path": "src/components/fitness/WorkoutLog.tsx.template", "props": { "workouts": "WorkoutSession[]" }, "mixins": ["_shared/Card.tsx.template"] },
    { "name": "NutritionTracker", "path": "src/components/fitness/NutritionTracker.tsx.template", "props": { "nutrition": "Nutrition", "meals": "Meal[]" }, "mixins": ["_shared/Card.tsx.template"] },
    { "name": "WeeklyOverview", "path": "src/components/fitness/WeeklyOverview.tsx.template", "props": { "weekly": "WeeklyActivity[]", "goals": "Goals" }, "mixins": ["_shared/Card.tsx.template"] },
    { "name": "AchievementBadge", "path": "src/components/fitness/AchievementBadge.tsx.template", "props": { "badges": "Badge[]", "challenges": "Challenge[]" }, "mixins": ["_shared/Card.tsx.template"] }
  ],
  "data_models": [
    {
      "name": "UserProfile",
      "fields": [
        { "name": "uid", "type": "string", "required": true },
        { "name": "display_name", "type": "string", "required": true },
        { "name": "fitness_goals", "type": "string[]", "required": false },
        { "name": "dietary_preferences", "type": "string[]", "required": false },
        { "name": "weight_kg", "type": "float", "required": false },
        { "name": "height_cm", "type": "float", "required": false },
        { "name": "age", "type": "integer", "required": false }
      ]
    },
    {
      "name": "WorkoutSession",
      "fields": [
        { "name": "id", "type": "integer", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "date", "type": "datetime", "required": true },
        { "name": "duration_min", "type": "integer", "required": true },
        { "name": "intensity", "type": "enum", "required": true, "default": "moderate" },
        { "name": "calories", "type": "integer", "required": false },
        { "name": "exercises", "type": "json[]", "required": false }
      ]
    },
    {
      "name": "MealEntry",
      "fields": [
        { "name": "id", "type": "integer", "required": true },
        { "name": "name", "type": "string", "required": true },
        { "name": "type", "type": "enum", "required": true },
        { "name": "calories", "type": "integer", "required": true },
        { "name": "protein_g", "type": "float", "required": false },
        { "name": "source", "type": "enum", "required": true, "default": "manual" }
      ]
    },
    {
      "name": "DailyActivity",
      "fields": [
        { "name": "date", "type": "date", "required": true },
        { "name": "steps", "type": "integer", "required": true, "default": 0 },
        { "name": "active_minutes", "type": "integer", "required": true, "default": 0 },
        { "name": "hydration_glasses", "type": "integer", "required": true, "default": 0 },
        { "name": "sleep_hours", "type": "float", "required": false },
        { "name": "mood", "type": "integer", "required": false }
      ]
    },
    {
      "name": "Achievement",
      "fields": [
        { "name": "name", "type": "string", "required": true },
        { "name": "description", "type": "string", "required": false },
        { "name": "icon", "type": "string", "required": true },
        { "name": "earned", "type": "boolean", "required": true, "default": false },
        { "name": "earned_at", "type": "datetime", "required": false }
      ]
    }
  ],
  "integrations": [
    { "service": "Firebase Authentication", "purpose": "Email, Google, and Apple sign-in", "config_params": {} },
    { "service": "Apple HealthKit", "purpose": "Steps, workouts, sleep, and heart-rate sync", "config_params": {} },
    { "service": "Fitbit Web API", "purpose": "Activity and sleep data import", "config_params": { "scopes": ["activity", "sleep"] } },
    { "service": "MyFitnessPal", "purpose": "Nutrition and calorie log import", "config_params": {} },
    { "service": "Strava", "purpose": "Runs, rides, and structured workouts import", "config_params": {} },
    { "service": "Firebase Cloud Messaging", "purpose": "Personalized push notifications", "config_params": {} },
    { "service": "Google Places", "purpose": "Nearby gym and fitness event discovery", "config_params": {} },
    { "service": "Open Food Facts", "purpose": "Barcode nutrition database lookup", "config_params": {} },
    { "service": "Google Analytics for Firebase", "purpose": "Engagement and retention analytics", "config_params": { "id": "{{deployment.analytics_id}}" } }
  ],
  "nfrs": [
    { "type": "Security", "requirement": "Health data encrypted at rest and in transit; HIPAA-aligned controls for PHI" },
    { "type": "Privacy", "requirement": "Granular consent for wearable data sharing and analytics" },
    { "type": "Accessibility", "requirement": "WCAG 2.1 AA; touch targets of 44px+ for mobile" },
