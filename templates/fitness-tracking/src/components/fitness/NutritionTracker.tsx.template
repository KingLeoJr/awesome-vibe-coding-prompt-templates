"use client";

import { motion } from "framer-motion";
import { Apple, Drumstick, Salad, Wheat } from "lucide-react";
import Card from "@/components/shared/Card";

export interface Macro {
  consumed: number;
  target: number;
}

export interface Nutrition {
  calories: Macro;
  protein: Macro;
  carbs: Macro;
  fat: Macro;
}

export interface Meal {
  id: number;
  name: string;
  type: string;
  calories: number;
  protein: number;
}

interface NutritionTrackerProps {
  nutrition: Nutrition;
  meals: Meal[];
}

export default function NutritionTracker({ nutrition, meals }: NutritionTrackerProps) {
  const macros = [
    { key: "calories", label: "Calories", unit: "kcal", ...nutrition.calories, barClass: "bg-[var(--color-accent)]", icon: Apple },
    { key: "protein", label: "Protein", unit: "g", ...nutrition.protein, barClass: "bg-[var(--color-primary)]", icon: Drumstick },
    { key: "carbs", label: "Carbs", unit: "g", ...nutrition.carbs, barClass: "bg-[var(--color-secondary)]", icon: Wheat },
    { key: "fat", label: "Fat", unit: "g", ...nutrition.fat, barClass: "bg-amber-500", icon: Salad },
  ] as const;

  return (
    <div className="space-y-6">
      <div className="grid gap-4 sm:grid-cols-2">
        {macros.map((macro, index) => {
          const ratio = Math.min(1, macro.consumed / macro.target);
          const Icon = macro.icon;
          return (
            <motion.div
              key={macro.key}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: index * 0.07 }}
            >
              <Card className="p-5">
                <div className="mb-3 flex items-center justify-between">
                  <span className="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-200">
                    <Icon size={16} className={macro.barClass} aria-hidden />
                    {macro.label}
                  </span>
                  <span className="text-sm text-gray-500 dark:text-gray-400 tabular-nums">
                    {macro.consumed} / {macro.target} {macro.unit}
                  </span>
                </div>
                <div
                  className="h-2.5 w-full overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800"
                  role="progressbar"
                  aria-label={`${macro.label} progress`}
                  aria-valuenow={Math.round(ratio * 100)}
                  aria-valuemin={0}
                  aria-valuemax={100}
                >
                  <motion.div
                    initial={{ width: 0 }}
                    whileInView={{ width: `${ratio * 100}%` }}
                    viewport={{ once: true }}
                    transition={{ duration: 0.8, ease: "easeOut", delay: index * 0.07 }}
                    className={`h-full rounded-full ${macro.barClass}`}
                  />
                </div>
                <p className="mt-2 text-right text-xs text-gray-400 dark:text-gray-500">
                  {Math.round(ratio * 100)}% of target
                </p>
              </Card>
            </motion.div>
          );
        })}
      </div>

      <Card className="p-6">
        <h3 className="mb-4 text-lg font-bold text-gray-900 dark:text-white">Today&apos;s meals</h3>
        <ul className="divide-y divide-gray-100 dark:divide-gray-800">
          {meals.map((meal) => (
            <li key={meal.id} className="flex items-center justify-between gap-4 py-3">
              <div className="flex items-center gap-3">
                <span className="rounded-lg bg-[var(--color-primary)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--color-primary)]">
                  {meal.type}
                </span>
                <span className="text-sm font-medium text-gray-700 dark:text-gray-200">{meal.name}</span>
              </div>
              <div className="text-right text-sm text-gray-500 dark:text-gray-400">
                <span className="tabular-nums">{meal.calories} kcal</span>
                <span className="ml-3 text-gray-400 dark:text-gray-500">· {meal.protein}g protein</span>
              </div>
            </li>
          ))}
        </ul>
      </Card>
    </div>
  );
}
