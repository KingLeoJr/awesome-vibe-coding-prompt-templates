"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { Search, Filter } from "lucide-react";

interface SearchBarProps {
  query: string;
  onSearch: (query: string) => void;
  categories?: string[];
  onCategorySelect?: (category: string) => void;
}

export default function SearchBar({ query, onSearch, categories, onCategorySelect }: SearchBarProps) {
  const [activeCategory, setActiveCategory] = React.useState<string | null>(null);

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="grid max-w-2xl mx-auto"
    >
      <div className="rounded-xl border border-gray-300 dark:border-gray-700 p-4 focus-within:ring-2 focus-[[theme.color.primary]]:focus-within">
        <div className="flex items-center gap-3">
          <Search className="h-5 w-5 text-gray-400 dark:text-gray-500" />
          <input
            type="text"
            value={query}
            onChange={(e) => onSearch(e.target.value)}
            placeholder="Search videos, channels, or movies..."
            className="flex-1 bg-transparent outline-none placeholder-gray-400 dark:placeholder-gray-500 text-gray-900 dark:text-white"
            aria-label "Search videos"
          />
          {categories && categories.length > 0 && (
            <div className="ml-3 group">
              {categories.map((category, index) => (
                <button
                  key={index}
                  onClick={() => onCategorySelect(category)}
                  className="px-2 py-1 rounded text-xs text-gray-400 dark:text-gray-500 hover:text-gray-900 dark:hover:text-white transition select-none"
                  aria-label={`Filter by ${category}`}
                >
                  {category}
                </button>
              ))}
            </div>
          )}
        </div>

        {activeCategory && (
          <div className="mt-2 pt-2 border-t border-gray-200 dark:border-gray-800">
            <span className="text-xs text-gray-500 dark:text-gray-400">
              Filtered by: {activeCategory}
            </span>
          </div>
        )}
      </div>
    </motion.div>
  );
}