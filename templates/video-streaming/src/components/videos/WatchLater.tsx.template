"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { Flag, Bookmark } from "lucide-react";

interface WatchLaterProps {
  videos: {
    id: string;
    title: string;
    thumbnailUrl: string;
    category: string;
  }[];
}

export default function WatchLater({ videos }: WatchLaterProps) {
  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ duration: 0.5 }}
      className="space-y-4"
    >
      <div>
        <h3 className="text-lg font-bold text-gray-900 dark:text-white">
          <Bookmark className="mr-2 h-4 w-4" /> Watch Later
        </h3>
      </div>

      {videos.length === 0 && (
        <div className="p-4 text-center text-gray-500 dark:text-gray-400">
          Nothing here yet. Add videos to watch later.
        </div>
      )}

      <div className="grid grid-cols-2 gap-4">
        {videos.map((video, index) => (
          <motion.div
            key={video.id}
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.3 * index }}
            className="group rounded-lg border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-lg transition-shadow cursor-pointer"
            aria-label="{video.title}"
          >
            <img
              src={video.thumbnailUrl}
              alt={video.title}
              className="w-full h-48 object-cover"
            />
            <div className="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black via-black/80 to-transparent">
              <p className="text-sm text-white">{video.title}</p>
            </div>
          </motion.div>
        ))}
      </div>

      {videos.length > 0 && (
        <div className="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800 text-center">
          <Flag className="h-4 w-4 text-gray-400 dark:text-gray-500 mr-2" />
          <span className="text-sm text-gray-500 dark:text-gray-400">
            {videos.length} {videos.length === 1 ? "saved" : "saved items"}
          </span>
        </div>
      )}
    </motion.div>
  );
}