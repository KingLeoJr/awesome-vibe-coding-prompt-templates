"use client";

import { motion } from "framer-motion";
import { cn } from "@/lib/utils";
import { Play, Eye, Heart } from "lucide-react";

interface VideoProps {
  id: string;
  title: string;
  description: string;
  duration: string;
  thumbnailUrl: string;
  viewCount: number;
  likeCount: number;
  category: string;
}

interface VideoCardProps {
  video: VideoProps;
  onPlay?: () => void;
  onWatchLater?: () => void;
}

export default function VideoCard({ video, onPlay, onWatchLater }: VideoCardProps) {
  const { id, title, description, duration, thumbnailUrl, viewCount, likeCount, category } = video;

  return (
    <motion.div
      initial={{ opacity: 0, x: -20 }}
      whileInView={{ opacity: 1, x: 0 }}
      transition={{ duration: 0.5 }}
      className="group rounded-lg border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-lg transition-shadow cursor-pointer"
      aria-label="Video: {title}"
    >
      <img
        src={thumbnailUrl}
        alt={title}
        className="w-full h-48 object-cover"
      />
      <div className="p-4 flex flex-col h-full">
        <h3 className="text-sm font-medium text-gray-900 dark:text-white line-clamp-2">{title}</h3>
        <p className="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-1">{description}</p>
        <div className="mt-auto flex items-end justify-between">
          <div className="flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
            <Eye className="h-3 w-3" />
            {duration}
          </div>
          <div className="flex items-center gap-2">
            <Heart
              className="h-3 w-3 text-red-500 group-hover:text-red-400"
              fill={likeCount > 0}
            />
            {likeCount}
          </div>
          <div className="flex items-center gap-2">
            <Play className="h-3 w-3 text-[[theme.color.primary]]" />
            {viewCount > 1000 ? `${Math.round(viewCount / 1000)}K` : viewCount} views
          </div>
        </div>
      </div>

      <div
        className="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black via-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"
        aria-label="Video description controls"
      >
        <p className="text-sm text-white">{description.substring(0, 100)}...</p>
        {onPlay && (
          <button
            onClick={onPlay}
            className="mt-2 inline-flex items-center justify-center rounded-full bg-white/20 p-2 hover:bg-white/30 transition"
            aria-label "Play {title}"
          >
            <Play className="h-4 w-4" />
            Play
          </button>
        )}
        {onWatchLater && (
          <button
            onClick={onWatchLater}
            className="mt-2 inline-flex items-center justify-center rounded-full bg-white/20 p-2 hover:bg-white/30 transition"
            aria-label "Add to Watch Later"
          >
            <Eye className="h-4 w-4" />
            Watch Later
          </button>
        )}
      </div>
    </motion.div>
  );
}