import Header from "@/components/layout/Header";
import CarePlanBuilder, { type CarePlan } from "@/components/care/CarePlanBuilder";
import CaregiverMatching, { type Caregiver } from "@/components/care/CaregiverMatching";
import ServiceDirectory, { type CareService } from "@/components/care/ServiceDirectory";
import HealthTracker, { type VitalSigns } from "@/components/care/HealthTracker";
import EventsCalendar, { type SeniorEvent } from "@/components/care/EventsCalendar";
import ResourceLibrary, { type CareResource } from "@/components/care/ResourceLibrary";
import Footer from "@/components/shared/Footer";
import care from "@/data/{{app.slug}}.json";

export default function Home() {
  return (
    <>
      <Header />
      <main className="pt-0">
        <section id="careplans" className="scroll-mt-24">
          <CarePlanBuilder plan={care.carePlan as CarePlan} />
        </section>

        <section id="caregivers" className="scroll-mt-24 bg-gray-50 dark:bg-gray-950/40">
          <CaregiverMatching caregivers={care.caregivers as Caregiver[]} currency={care.currency as string} />
        </section>

        <section id="services" className="scroll-mt-24">
          <ServiceDirectory
            services={care.services as CareService[]}
            categories={care.serviceCategories as string[]}
          />
        </section>

        <section id="health" className="scroll-mt-24 bg-gray-50 dark:bg-gray-950/40">
          <HealthTracker vitals={care.vitals as VitalSigns} />
        </section>

        <section id="events" className="scroll-mt-24">
          <EventsCalendar
            events={care.events as SeniorEvent[]}
            categories={care.eventCategories as string[]}
          />
        </section>

        <section id="resources" className="scroll-mt-24 bg-gray-50 dark:bg-gray-950/40">
          <ResourceLibrary
            resources={care.resources as CareResource[]}
            topics={care.resourceTopics as string[]}
          />
        </section>
      </main>
      <Footer name={care.app.name as string} description={care.app.tagline as string} />
