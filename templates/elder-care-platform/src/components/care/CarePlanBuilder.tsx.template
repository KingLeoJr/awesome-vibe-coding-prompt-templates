"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { CalendarCheck2, ClipboardPlus, Clock, HeartPulse, Pill, UserRound } from "lucide-react";
import { cn } from "@/lib/utils";

export interface CarePatient {
  name: string;
  age: number;
  conditions: string[];
  mobility: string;
}

export interface RoutineEntry {
  id: string;
  time: string;
  activity: string;
}

export interface Medication {
  id: string;
  name: string;
  dosage: string;
  schedule: string;
  taken: boolean;
  reminder: boolean;
}

export interface Appointment {
  id: string;
  title: string;
  date: string;
  time: string;
  provider: string;
}

export interface CarePlan {
  patient: CarePatient;
  routine: RoutineEntry[];
  medications: Medication[];
  appointments: Appointment[];
}

interface CarePlanBuilderProps {
  plan: CarePlan;
}

export default function CarePlanBuilder({ plan }: CarePlanBuilderProps) {
  const [taken, setTaken] = useState<Set<string>>(
    () => new Set(plan.medications.filter((m) => m.taken).map((m) => m.id))
  );

  const toggleTaken = (id: string) => {
    setTaken((prev) => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  const takenCount = taken.size;

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="careplans-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div className="flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
              <ClipboardPlus size={22} aria-hidden="true" />
            </span>
            <div>
              <h2 id="careplans-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Care plan</h2>
              <p className="text-sm text-gray-500 dark:text-gray-400">Daily routines, medications, and appointments — all in one place.</p>
            </div>
          </div>
          <span className="rounded-full bg-[var(--color-primary)]/10 px-4 py-1.5 text-sm font-semibold text-[var(--color-primary)]">
            {takenCount}/{plan.medications.length} meds taken today
          </span>
        </div>

        <div className="mb-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
          <div className="flex flex-wrap items-center gap-4">
            <span className="flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
              <UserRound size={22} aria-hidden="true" />
            </span>
            <div className="min-w-0 flex-1">
              <h3 className="text-lg font-semibold text-gray-900 dark:text-white">{plan.patient.name}, {plan.patient.age}</h3>
              <p className="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                <span className="rounded-full bg-gray-100 px-2.5 py-0.5 dark:bg-gray-900">{plan.patient.mobility}</span>
                {plan.patient.conditions.map((c) => (
                  <span key={c} className="rounded-full bg-gray-100 px-2.5 py-0.5 dark:bg-gray-900">{c}</span>
                ))}
              </p>
            </div>
          </div>
        </div>

        <div className="grid gap-6 lg:grid-cols-3">
          <div className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 lg:col-span-1">
            <h3 className="flex items-center gap-2.5 font-semibold text-gray-900 dark:text-white">
              <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
                <Clock size={18} aria-hidden="true" />
              </span>
              Daily routine
            </h3>
            <ol className="mt-4 flex flex-col gap-3" aria-label="Daily routine">
              {plan.routine.map((entry) => (
                <motion.li
                  key={entry.id}
                  initial={{ opacity: 0, x: -8 }}
                  whileInView={{ opacity: 1, x: 0 }}
                  viewport={{ once: true }}
                  transition={{ duration: 0.3 }}
                  className="flex items-center gap-3 rounded-xl bg-gray-50 px-3 py-2.5 dark:bg-gray-900"
                >
                  <span className="shrink-0 rounded-md bg-[var(--color-accent)]/10 px-2 py-0.5 text-xs font-semibold text-[var(--color-accent)]">
                    {entry.time}
                  </span>
                  <span className="text-sm text-gray-700 dark:text-gray-200">{entry.activity}</span>
                </motion.li>
              ))}
            </ol>
          </div>

          <div className="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6 lg:col-span-2">
            <h3 className="flex items-center gap-2.5 font-semibold text-gray-900 dark:text-white">
              <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-[var(--color-primary)]">
                <Pill size={18} aria-hidden="true" />
              </span>
              Medication schedule
            </h3>
            <ul className="mt-4 grid gap-3 sm:grid-cols-2" aria-label="Medication schedule">
              {plan.medications.map((med, i) => {
                const isTaken = taken.has(med.id);
                return (
                  <motion.li
                    key={med.id}
                    initial={{ opacity: 0, y: 12 }}
                    whileInView={{ opacity: 1, y: 0 }}
                    viewport={{ once: true }}
                    transition={{ duration: 0.35, delay: i * 0.05 }}
                    className="rounded-xl border border-gray-200 p-4 dark:border-gray-800"
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div>
                        <p className="font-medium text-gray-900 dark:text-white">{med.name}</p>
                        <p className="text-xs text-gray-500 dark:text-gray-400">{med.dosage} · {med.schedule}</p>
                      </div>
                      <span className={cn("h-2 w-2 shrink-0 rounded-full", med.reminder ? "bg-[var(--color-accent)]" : "bg-gray-300 dark:bg-gray-700")} aria-hidden="true" />
                    </div>
                    <button
                      onClick={() => toggleTaken(med.id)}
                      aria-pressed={isTaken}
                      className={cn(
                        "mt-3 w-full rounded-full px-4 py-2 text-xs font-medium transition",
                        isTaken
                          ? "bg-[var(--color-secondary)] text-white hover:opacity-90"
                          : "bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-900 dark:text-gray-300 dark:hover:bg-gray-800"
                      )}
                    >
                      {isTaken ? "Marked taken" : "Mark taken"}
                    </button>
                  </motion.li>
                );
              })}
            </ul>
          </div>
        </div>

        <div className="mt-6 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6">
          <h3 className="flex items-center gap-2.5 font-semibold text-gray-900 dark:text-white">
            <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
              <CalendarCheck2 size={18} aria-hidden="true" />
            </span>
            Upcoming appointments
          </h3>
          <ul className="mt-4 grid gap-3 md:grid-cols-2" aria-label="Upcoming appointments">
            {plan.appointments.map((appt) => (
              <li key={appt.id} className="flex items-center gap-3 rounded-xl bg-gray-50 px-4 py-3 dark:bg-gray-900">
                <span className="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
                  <HeartPulse size={17} aria-hidden="true" />
                </span>
                <div className="min-w-0 flex-1">
                  <p className="text-sm font-medium text-gray-900 dark:text-white">{appt.title}</p>
                  <p className="text-xs text-gray-500 dark:text-gray-400">{appt.date} · {appt.time} · {appt.provider}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </motion.div>
    </section>
  );
}