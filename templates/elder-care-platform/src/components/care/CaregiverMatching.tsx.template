"use client";

import { useMemo, useState } from "react";
import { motion } from "framer-motion";
import { BadgeCheck, CalendarClock, Star, Users } from "lucide-react";
import { cn } from "@/lib/utils";

export interface Caregiver {
  id: string;
  name: string;
  role: string;
  rating: number;
  reviews: number;
  yearsExperience: number;
  hourlyRate: number;
  specialties: string[];
  availableNow: boolean;
}

interface CaregiverMatchingProps {
  caregivers: Caregiver[];
  currency?: string;
}

export default function CaregiverMatching({ caregivers, currency = "{{currency.symbol}}" }: CaregiverMatchingProps) {
  const [availableOnly, setAvailableOnly] = useState(false);

  const filtered = useMemo(() => {
    return availableOnly ? caregivers.filter((c) => c.availableNow) : caregivers;
  }, [caregivers, availableOnly]);

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="caregivers-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex flex-wrap items-center justify-between gap-4 mb-8">
          <div className="flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
              <Users size={22} aria-hidden="true" />
            </span>
            <div>
              <h2 id="caregivers-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Matched caregivers</h2>
              <p className="text-sm text-gray-500 dark:text-gray-400">Qualified caregivers matched to your care needs and preferences.</p>
            </div>
          </div>

          <label className="flex cursor-pointer items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
            <input
              type="checkbox"
              checked={availableOnly}
              onChange={(e) => setAvailableOnly(e.target.checked)}
              className="h-4 w-4 rounded border-gray-300 text-[var(--color-secondary)] focus:ring-[var(--color-secondary)]"
            />
            Available now
          </label>
        </div>

        <div className="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {filtered.map((caregiver, i) => (
            <motion.article
              key={caregiver.id}
              initial={{ opacity: 0, y: 16 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.4, delay: i * 0.06 }}
              className="flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-6"
            >
              <div className="flex items-start justify-between gap-3">
                <div>
                  <h3 className="font-semibold text-gray-900 dark:text-white">{caregiver.name}</h3>
                  <p className="mt-0.5 text-sm text-[var(--color-secondary)]">{caregiver.role}</p>
                </div>
                <span className="flex items-center gap-1 rounded-full bg-[var(--color-accent)]/10 px-2.5 py-1 text-xs font-semibold text-[var(--color-accent)]">
                  <Star size={13} aria-hidden="true" />
                  {caregiver.rating.toFixed(1)}
                </span>
              </div>

              <dl className="mt-4 grid grid-cols-2 gap-3 text-sm">
                <div className="rounded-xl bg-gray-50 p-3 dark:bg-gray-900">
                  <dt className="text-xs text-gray-500 dark:text-gray-400">Experience</dt>
                  <dd className="mt-0.5 font-medium text-gray-900 dark:text-white">{caregiver.yearsExperience} yrs</dd>
                </div>
                <div className="rounded-xl bg-gray-50 p-3 dark:bg-gray-900">
                  <dt className="text-xs text-gray-500 dark:text-gray-400">Reviews</dt>
                  <dd className="mt-0.5 font-medium text-gray-900 dark:text-white">{caregiver.reviews}</dd>
                </div>
              </dl>

              <div className="mt-4 flex flex-wrap gap-2" role="list" aria-label={`${caregiver.name} specialties`}>
                {caregiver.specialties.map((s) => (
                  <span key={s} className="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-gray-900 dark:text-gray-300">
                    {s}
                  </span>
                ))}
              </div>

              <div className="mt-5 flex items-center justify-between border-t border-gray-100 pt-4 dark:border-gray-800">
                <div>
                  <p className="text-lg font-bold text-gray-900 dark:text-white">
                    {currency}{caregiver.hourlyRate}
                    <span className="text-xs font-normal text-gray-400"> / hour</span>
                  </p>
                </div>
                <span
                  className={cn(
                    "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold",
                    caregiver.availableNow
                      ? "bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]"
                      : "bg-gray-100 text-gray-500 dark:bg-gray-900 dark:text-gray-400"
                  )}
                >
                  <BadgeCheck size={14} aria-hidden="true" />
                  {caregiver.availableNow ? "Available now" : "On schedule"}
                </span>
              </div>

              <div className="mt-4 flex gap-3">
                <button className="flex-1 rounded-full bg-[var(--color-primary)] px-4 py-2.5 text-sm font-medium text-white hover:opacity-90 transition">
                  View profile
                </button>
                <button className="inline-flex items-center justify-center gap-1.5 rounded-full bg-[var(--color-secondary)] px-4 py-2.5 text-sm font-medium text-white hover:opacity-90 transition">
                  <CalendarClock size={15} aria-hidden="true" />
                  Book
                </button>
              </div>
            </motion.article>
          ))}
        </div>

        {filtered.length === 0 && (
          <p className="rounded-2xl border border-dashed border-gray-300 p-8 text-center text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
            No caregivers available right now. Check back soon.
          </p>
        )}
      </motion.div>
    </section>
  );
}