"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { Cpu, Home, Plug, Power, Thermometer, type LucideIcon } from "lucide-react";
import { cn } from "@/lib/utils";

export interface EnergyDevice {
  id: string;
  name: string;
  type: string;
  powerW: number;
  status: string;
  online: boolean;
  automation: boolean;
}

interface DeviceAutomationProps {
  devices: EnergyDevice[];
}

const TYPE_ICONS: Record<string, LucideIcon> = {
  thermostat: Thermometer,
  plug: Plug,
  appliance: Cpu,
  hvac: Home,
};

function nextStatus(status: string): string {
  return status === "on" ? "off" : "on";
}

export default function DeviceAutomation({ devices }: DeviceAutomationProps) {
  const [statuses, setStatuses] = useState<Record<string, string>>(() =>
    Object.fromEntries(devices.map((d) => [d.id, d.status]))
  );

  const toggle = (id: string) => {
    setStatuses((prev) => ({ ...prev, [id]: nextStatus(prev[id] ?? "off") }));
  };

  return (
    <section className="mx-auto max-w-7xl px-6 py-16" aria-labelledby="devices-heading">
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5 }}
      >
        <div className="flex items-center gap-3 mb-8">
          <span className="flex h-11 w-11 items-center justify-center rounded-2xl bg-[var(--color-secondary)]/10 text-[var(--color-secondary)]">
            <Plug size={22} aria-hidden="true" />
          </span>
          <div>
            <h2 id="devices-heading" className="text-3xl font-bold text-gray-900 dark:text-white">Smart device automation</h2>
            <p className="text-sm text-gray-500 dark:text-gray-400">Control connected devices and arm energy-saving automations.</p>
          </div>
        </div>

        <div className="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {devices.map((device, i) => {
            const Icon = TYPE_ICONS[device.type] ?? Power;
            const isOn = (statuses[device.id] ?? device.status) === "on";
            return (
              <motion.article
                key={device.id}
                initial={{ opacity: 0, y: 16 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true }}
                transition={{ duration: 0.4, delay: i * 0.06 }}
                className="flex flex-col gap-3 rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 p-5"
              >
                <div className="flex items-start justify-between gap-3">
                  <span
                    className={cn(
                      "flex h-10 w-10 items-center justify-center rounded-xl",
                      isOn
                        ? "bg-[var(--color-primary)]/10 text-[var(--color-primary)]"
                        : "bg-gray-100 dark:bg-gray-900 text-gray-400"
                    )}
                  >
                    <Icon size={20} aria-hidden="true" />
                  </span>
                  {!device.online && (
                    <span className="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-500 dark:bg-gray-900 dark:text-gray-400">
                      Offline
                    </span>
                  )}
                </div>

                <div>
                  <h3 className="text-sm font-bold text-gray-900 dark:text-white">{device.name}</h3>
                  <p className="mt-0.5 text-xs text-gray-500 dark:text-gray-400">{device.powerW} W when running</p>
                </div>

                <div className="mt-auto flex items-center justify-between">
                  <span
                    className={cn(
                      "inline-flex items-center gap-1.5 text-xs font-semibold capitalize",
                      isOn ? "text-emerald-600 dark:text-emerald-400" : "text-gray-400 dark:text-gray-500"
                    )}
                  >
                    <span className={cn("h-1.5 w-1.5 rounded-full", isOn ? "bg-emerald-500" : "bg-gray-300 dark:bg-gray-700")} aria-hidden="true" />
                    {(statuses[device.id] ?? device.status)}
                  </span>

                  {device.online && (
                    <button
                      onClick={() => toggle(device.id)}
                      aria-label={`Toggle ${device.name}`}
                      aria-pressed={isOn}
                      className={cn(
                        "relative h-6 w-11 rounded-full transition-colors",
                        isOn ? "bg-[var(--color-primary)]" : "bg-gray-200 dark:bg-gray-800"
                      )}
                    >
                      <span
                        className={cn(
                          "absolute top-0.5 h-5 w-5 rounded-full bg-white shadow transition-all",
                          isOn ? "left-[22px]" : "left-0.5"
                        )}
                      />
                    </button>
                  )}

                  {device.automation && (
                    <span className="rounded-full bg-[var(--color-accent)]/10 px-2.5 py-1 text-[11px] font-semibold text-[var(--color-accent)]">
                      Auto
                    </span>
                  )}
                </div>
              </motion.article>
            );
          })}
        </div>
      </motion.div>
    </section>
  );
}