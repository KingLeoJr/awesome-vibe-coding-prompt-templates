import { motion } from "framer-motion";
import { ArrowRight, Award, Gift, PiggyBank, Trophy, Wallet } from "lucide-react";
import { cn } from "@/lib/utils";
import { impact as sampleImpact } from "@/data/{{app.slug}}.json";

export interface ImpactStat {
  id: string;
  label: string;
  value: string;
  suffix?: string;
  delta: string;
}

interface SavingsImpactProps {
  impact?: ImpactStat[];
  referralCode?: string;
  locale?: string;
  currency?: string;
}

export default function SavingsImpact({
  impact = sampleImpact,
  referralCode = "SAVE20",
  locale = "{{i18n.default_locale}}",
  currency = "{{i18n.currency}}",
}: SavingsImpactProps) {
  return (
    <div className="grid gap-6 lg:grid-cols-3">
      <div className="grid gap-4 sm:grid-cols-2 lg:col-span-2">
        {impact.map((stat, index) => {
          const icons = [PiggyBank, Wallet, Gift, Trophy];
          const Icon = icons[index % icons.length];
          return (
            <motion.div
              key={stat.id}
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true }}
              transition={{ duration: 0.45, delay: index * 0.07 }}
              className="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-gray-950"
            >
              <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)]">
                <Icon size={19} />
              </span>
              <p className="mt-3 text-2xl font-black text-gray-900 dark:text-white">
                {stat.value}
                <span className="text-base font-semibold text-gray-400">{stat.suffix ?? ""}</span>
              </p>
              <p className="text-xs text-gray-500 dark:text-gray-400">
                {stat.label} · <span className="text-[var(--color-accent)]">{stat.delta}</span>
              </p>
            </motion.div>
          );
        })}
      </div>

      <motion.div
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true }}
        transition={{ duration: 0.5, delay: 0.15 }}
        className="flex flex-col justify-between rounded-2xl border border-[var(--color-accent)]/30 bg-gradient-to-br from-[var(--color-accent)]/10 to-transparent p-6"
      >
        <div>
          <span className="inline-flex items-center gap-1.5 rounded-full bg-[var(--color-accent)]/10 px-3 py-1 text-xs font-semibold text-[var(--color-accent)]">
            <Award size={13} />
            Referral program
          </span>
          <h3 className="mt-3 text-xl font-bold text-gray-900 dark:text-white">
            Invite friends, both save {currency === "USD" ? "$" : currency} 5
          </h3>
          <p className="mt-2 text-sm text-gray-500 dark:text-gray-400">
            Share your code and earn rewards every time a friend joins, submits a deal, or redeems a coupon.
          </p>
        </div>
        <div className="mt-6">
          <div className="flex items-stretch gap-2">
            <code className="flex-1 rounded-xl border border-dashed border-gray-300 bg-white px-3 py-2.5 text-center text-sm font-bold tracking-widest text-gray-800 dark:border-gray-600 dark:bg-gray-950 dark:text-gray-100">
              {referralCode}
            </code>
            <a
              href="#impact"
              className="inline-flex items-center gap-1.5 rounded-xl bg-[var(--color-accent)] px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90"
            >
              Share <ArrowRight size={14} />
            </a>
          </div>
          <p className="mt-3 text-center text-xs text-gray-400">
            {new Intl.NumberFormat(locale, { style: "currency", currency }).format(0)} of{" "}
            {new Intl.NumberFormat(locale, { style: "currency", currency }).format(500)} to next reward
          </p>
        </div>
      </motion.div>
    </div>
  );
}