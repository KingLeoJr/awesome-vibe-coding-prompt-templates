"use client";

import { useState } from "react";
import { motion } from "framer-motion";
import { BadgeCheck, Bookmark, Clock, Copy, Store, Tag } from "lucide-react";
import { cn } from "@/lib/utils";

export interface Coupon {
  id: string;
  title: string;
  store: string;
  category: string;
  discount: string;
  code: string;
  expires: string;
  verified: boolean;
  redemptions: number;
}

interface CouponCardProps {
  coupon: Coupon;
  index?: number;
  locale?: string;
  currency?: string;
}

export default function CouponCard({
  coupon,
  index = 0,
  locale = "{{i18n.default_locale}}",
  currency = "{{i18n.currency}}",
}: CouponCardProps) {
  const [copied, setCopied] = useState(false);
  const [saved, setSaved] = useState(false);

  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(coupon.code);
    } catch {
      const input = document.createElement("input");
      input.value = coupon.code;
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
    }
    setCopied(true);
    window.setTimeout(() => setCopied(false), 2000);
  };

  return (
    <motion.article
      initial={{ opacity: 0, y: 24 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-40px" }}
      transition={{ duration: 0.5, delay: index * 0.06 }}
      className="group flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-[var(--color-primary)]/40 hover:shadow-md dark:border-gray-800 dark:bg-gray-950"
    >
      <div className="flex items-start justify-between gap-3">
        <span className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[var(--color-primary)]/10 text-2xl font-black text-[var(--color-primary)]">
          {coupon.discount.replace(/[^0-9]/g, "").slice(0, 2)}
        </span>
        <div className="flex items-center gap-1.5">
          {coupon.verified && (
            <span
              className="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400"
              title="Verified"
            >
              <BadgeCheck size={12} />
              Verified
            </span>
          )}
          <button
            onClick={() => setSaved((s) => !s)}
            aria-pressed={saved}
            aria-label={saved ? "Remove from saved" : "Save coupon"}
            className={cn(
              "rounded-lg p-1.5 transition",
              saved
                ? "text-[var(--color-primary)]"
                : "text-gray-400 hover:text-[var(--color-primary)]"
            )}
          >
            <Bookmark size={17} fill={saved ? "currentColor" : "none"} />
          </button>
        </div>
      </div>

      <div>
        <h3 className="font-semibold leading-snug text-gray-900 dark:text-white">{coupon.title}</h3>
        <p className="mt-1 flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400">
          <Store size={12} className="text-[var(--color-secondary)]" />
          {coupon.store}
          <span aria-hidden="true">·</span>
          <Tag size={12} className="text-[var(--color-secondary)]" />
          {coupon.category}
        </p>
      </div>

      <div className="flex items-center gap-2 text-xs text-gray-500 dark:text-gray-400">
        <Clock size={13} className="text-[var(--color-secondary)]" />
        <span>
          Expires{" "}
          {new Date(coupon.expires).toLocaleDateString(locale, {
            month: "short",
            day: "numeric",
            year: "numeric",
          })}
        </span>
      </div>

      <div className="mt-auto">
        <div className="flex items-stretch gap-2">
          <code className="flex-1 truncate rounded-xl border border-dashed border-gray-300 bg-gray-50 px-3 py-2.5 text-sm font-semibold tracking-wide text-gray-800 dark:border-gray-600 dark:bg-gray-900 dark:text-gray-100">
            {coupon.code}
          </code>
          <button
            onClick={handleCopy}
            className="inline-flex items-center gap-1.5 rounded-xl bg-[var(--color-primary)] px-4 py-2.5 text-sm font-medium text-white transition hover:opacity-90"
          >
            <Copy size={14} />
            {copied ? "Copied!" : "Copy"}
          </button>
        </div>
        <p className="mt-2 text-xs text-gray-400 dark:text-gray-500">
          {coupon.redemptions.toLocaleString(locale)} redemptions · saves{" "}
          {new Intl.NumberFormat(locale, { style: "currency", currency }).format(coupon.redemptions * 12)}
          /yr
        </p>
      </div>
    </motion.article>
  );
}